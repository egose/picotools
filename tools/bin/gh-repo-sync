#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" commands version

REPOS_DIR="${PWD}/repos"
CACHE_FILE="${PWD}/repo-updates.json"
PAT_FILE="${XDG_DATA_HOME:-$HOME/.local/share}/gh-repo-sync/pat"
PER_PAGE=100

REQUIRED_TOOLS=(curl jq unzip)
GH_REPO_SYNC_TMPPATHS=()

usage() {
  cat <<'EOF'
Usage: gh-repo-sync [--reset-pat]

Downloads and extracts repositories for a GitHub user or organization into
./repos/<owner>/<repo>, and caches update timestamps in ./repo-updates.json.

Options:
  --reset-pat                 Remove the stored GitHub PAT and exit
  --debug                     Print progress details to stderr
  -h, --help, help           Show this help message
  -v, --version, version     Show the tool version
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

debug_mode=false

debug_enabled() {
  [ "$debug_mode" = 'true' ]
}

debug_log() {
  if debug_enabled; then
    printf '[gh-repo-sync] %s\n' "$1" >&2
  fi
}

cleanup_tmppaths() {
  if [ "${#GH_REPO_SYNC_TMPPATHS[@]}" -gt 0 ]; then
    rm -rf "${GH_REPO_SYNC_TMPPATHS[@]}"
  fi
}

register_tmppath() {
  GH_REPO_SYNC_TMPPATHS+=("$1")
}

# --- PAT management ---

check_required_tools() {
  picotools_require_commands "${REQUIRED_TOOLS[@]}"
}

load_pat() {
  if [ -n "${GITHUB_PAT:-}" ]; then
    debug_log 'Using GITHUB_PAT from the environment'
    return
  fi

  if [ -f "$PAT_FILE" ]; then
    GITHUB_PAT=$(<"$PAT_FILE")
    export GITHUB_PAT
    debug_log "Loaded GitHub PAT from '$PAT_FILE'"
    return
  fi

  printf '%s' "Enter your GitHub Personal Access Token (leave empty for public repos): "
  read -rs GITHUB_PAT
  printf '\n'

  if [ -n "$GITHUB_PAT" ]; then
    mkdir -p "$(dirname "$PAT_FILE")"
    printf '%s\n' "$GITHUB_PAT" >"$PAT_FILE"
    chmod 600 "$PAT_FILE"
    export GITHUB_PAT
    echo "Token saved to $PAT_FILE"
  else
    debug_log 'Continuing without a GitHub PAT'
    echo "Continuing without authentication (rate limit: 60 requests/hour)."
  fi
}

# --- Cache helpers ---

load_cache() {
  if [ -f "$CACHE_FILE" ]; then
    printf '%s\n' "$(<"$CACHE_FILE")"
  else
    printf '{}\n'
  fi
}

get_cached_value() {
  local cache="$1" key="$2"
  jq -r --arg k "$key" '.[$k] // empty' <<<"$cache"
}

set_cached_value() {
  local cache="$1" key="$2" value="$3"
  jq --arg k "$key" --arg v "$value" '. + {($k): $v}' <<<"$cache"
}

save_cache() {
  local cache="$1"
  jq '.' <<<"$cache" >"$CACHE_FILE"
  echo "Update cache saved."
}

# --- GitHub API ---

gh_api() {
  local endpoint="$1"
  local url="https://api.github.com${endpoint}"
  local http_code body tmpfile

  tmpfile=$(mktemp)
  register_tmppath "$tmpfile"
  local auth_header=()
  if [ -n "${GITHUB_PAT:-}" ]; then
    auth_header=(-H "Authorization: token ${GITHUB_PAT}")
  fi
  debug_log "Requesting GitHub API endpoint '$endpoint'"
  http_code=$(curl -s -w '%{http_code}' -o "$tmpfile" \
    "${auth_header[@]}" \
    -H "Accept: application/vnd.github+json" \
    "$url")

  body=$(<"$tmpfile")
  rm -f "$tmpfile"

  if [ "$http_code" -ge 200 ] && [ "$http_code" -lt 300 ]; then
    printf '%s\n' "$body"
    return 0
  else
    local message
    message=$(jq -r '.message // empty' <<<"$body" 2>/dev/null)
    echo "API error (HTTP ${http_code}): ${message:-$body}" >&2
    return 1
  fi
}

download_repo_archive() {
  local owner="$1"
  local repo_name="$2"
  local default_branch="$3"
  local destination="$4"
  local url="https://api.github.com/repos/${owner}/${repo_name}/zipball/${default_branch}"
  local auth_header=()
  local response_code
  local message
  local tmp_zip
  local attempt=1
  local max_attempts=3

  if [ -n "${GITHUB_PAT:-}" ]; then
    auth_header=(-H "Authorization: token ${GITHUB_PAT}")
  fi

  while [ "$attempt" -le "$max_attempts" ]; do
    debug_log "Downloading archive for '${repo_name}' attempt ${attempt}/${max_attempts}"
    tmp_zip=$(mktemp "${destination}.XXXXXX")
    register_tmppath "$tmp_zip"
    response_code=$(curl -sS -L --retry 2 --retry-delay 1 --retry-all-errors \
      -w '%{http_code}' \
      -o "$tmp_zip" \
      "${auth_header[@]}" \
      "$url" || true)

    if [ -n "$response_code" ] && [ "$response_code" -ge 200 ] && [ "$response_code" -lt 300 ]; then
      if unzip -tq "$tmp_zip" >/dev/null 2>&1; then
        mv "$tmp_zip" "$destination"
        return 0
      fi

      echo "Downloaded archive for ${repo_name} was not a valid zip file." >&2
    else
      message=$(jq -r '.message // empty' <"$tmp_zip" 2>/dev/null || true)
      if [ -n "$message" ]; then
        echo "Archive download failed for ${repo_name} (HTTP ${response_code}): ${message}" >&2
      else
        echo "Archive download failed for ${repo_name} (HTTP ${response_code:-unknown})." >&2
      fi
    fi

    rm -f "$tmp_zip"

    if [ "$attempt" -lt "$max_attempts" ]; then
      echo "Retrying ${repo_name} download (${attempt}/${max_attempts})..." >&2
      sleep 1
    fi

    attempt=$((attempt + 1))
  done

  return 1
}

cache_key() {
  local owner="$1"
  local repo_name="$2"

  printf '%s/%s\n' "$owner" "$repo_name"
}

repo_target_dir() {
  local owner="$1"
  local repo_name="$2"

  printf '%s/%s/%s\n' "$REPOS_DIR" "$owner" "$repo_name"
}

extract_archive_root_dir() {
  local extract_root="$1"
  local -a extracted_entries=()

  shopt -s dotglob nullglob
  extracted_entries=("$extract_root"/*)
  shopt -u dotglob nullglob

  if [ "${#extracted_entries[@]}" -ne 1 ] || [ ! -d "${extracted_entries[0]}" ]; then
    return 1
  fi

  printf '%s\n' "${extracted_entries[0]}"
}

replace_repo_from_archive() {
  local archive_path="$1"
  local owner="$2"
  local repo_name="$3"
  local extract_root extracted_dir target_dir owner_dir

  extract_root=$(mktemp -d "${REPOS_DIR}/extract.${owner}.${repo_name}.XXXXXX")
  register_tmppath "$extract_root"

  if ! unzip -qo "$archive_path" -d "$extract_root" >/dev/null 2>&1; then
    echo "Error processing ${owner}/${repo_name}" >&2
    return 1
  fi

  extracted_dir=$(extract_archive_root_dir "$extract_root") || {
    echo "Error: unexpected archive layout for ${owner}/${repo_name}" >&2
    return 1
  }

  owner_dir="${REPOS_DIR}/${owner}"
  target_dir=$(repo_target_dir "$owner" "$repo_name")
  mkdir -p "$owner_dir"
  rm -rf "$target_dir"
  mv "$extracted_dir" "$target_dir"
}

fetch_all_repos() {
  local name="$1"
  local page=1
  local all_repos="[]"

  while true; do
    echo "Fetching page ${page}..." >&2
    debug_log "Fetching repository page ${page} for '${name}'"

    # Try as org first, then as user
    local data
    data=$(gh_api "/orgs/${name}/repos?per_page=${PER_PAGE}&page=${page}" 2>/dev/null) ||
      data=$(gh_api "/users/${name}/repos?per_page=${PER_PAGE}&page=${page}") ||
      {
        echo "Error: failed to fetch repos for ${name}" >&2
        exit 1
      }

    local count
    count=$(jq 'length' <<<"$data")
    if [ "$count" -eq 0 ]; then
      break
    fi

    all_repos=$(jq -s '.[0] + .[1]' <<<"${all_repos}"$'\n'"${data}")
    page=$((page + 1))
  done

  printf '%s\n' "$all_repos"
}

# --- Main ---

main() {
  trap 'cleanup_tmppaths' EXIT

  while [ $# -gt 0 ]; do
    case "${1:-}" in
    --debug)
      debug_mode=true
      shift
      ;;
    -h | --help | help)
      usage
      exit 0
      ;;
    -v | --version | version)
      print_version
      exit 0
      ;;
    --reset-pat)
      rm -f "$PAT_FILE"
      echo "PAT has been reset."
      exit 0
      ;;
    "")
      break
      ;;
    *)
      echo "Error: unexpected argument: $1" >&2
      usage >&2
      exit 1
      ;;
    esac
  done

  check_required_tools

  load_pat

  printf '%s' "Enter the GitHub username or organization name: "
  read -r org_name

  if [ -z "$org_name" ]; then
    echo "Error: name cannot be empty" >&2
    exit 1
  fi

  mkdir -p "$REPOS_DIR"
  debug_log "Syncing repositories into '$REPOS_DIR' using cache '$CACHE_FILE'"

  local cache
  cache=$(load_cache)

  echo "Fetching repositories for: ${org_name}"
  local repos
  repos=$(fetch_all_repos "$org_name")

  local total
  total=$(jq 'length' <<<"$repos")
  echo "Total repositories found: ${total}"

  local i=0
  while [ "$i" -lt "$total" ]; do
    local repo_name repo_owner default_branch updated_at
    local cached_updated cache_entry_key zip_path
    repo_name=$(jq -r ".[$i].name" <<<"$repos")
    repo_owner=$(jq -r ".[$i].owner.login // empty" <<<"$repos")
    default_branch=$(jq -r ".[$i].default_branch" <<<"$repos")
    updated_at=$(jq -r ".[$i].updated_at" <<<"$repos")

    if [ -z "$repo_owner" ]; then
      repo_owner="$org_name"
    fi

    cache_entry_key=$(cache_key "$repo_owner" "$repo_name")
    cached_updated=$(get_cached_value "$cache" "$cache_entry_key")

    if [ -n "$cached_updated" ] && [ "$cached_updated" = "$updated_at" ]; then
      echo "Skipping ${cache_entry_key} (no updates since last run)"
      i=$((i + 1))
      continue
    fi

    zip_path=$(mktemp "${REPOS_DIR}/archive.${repo_owner}.${repo_name}.XXXXXX.zip")
    register_tmppath "$zip_path"

    echo "Downloading ${cache_entry_key}..."
    if ! download_repo_archive "$repo_owner" "$repo_name" "$default_branch" "$zip_path"; then
      rm -f "$zip_path"
      echo "Failed to download ${cache_entry_key}" >&2
      i=$((i + 1))
      continue
    fi

    if replace_repo_from_archive "$zip_path" "$repo_owner" "$repo_name"; then
      rm -f "$zip_path"
      cache=$(set_cached_value "$cache" "$cache_entry_key" "${updated_at:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}")
    fi

    i=$((i + 1))
  done

  save_cache "$cache"
}

main "$@"
