git_year_range() {
  local first_year=''
  local last_year=''

  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf '%s\n' "$(date +%Y)"
    return 0
  fi

  first_year=$(git log --reverse --format=%ad --date=format:%Y | while IFS= read -r year; do
    if [ -n "$year" ]; then
      printf '%s\n' "$year"
      break
    fi
  done)
  last_year=$(git log -1 --format=%ad --date=format:%Y 2>/dev/null || true)

  if [ -z "$first_year" ] || [ -z "$last_year" ]; then
    printf '%s\n' "$(date +%Y)"
    return 0
  fi

  if [ "$first_year" = "$last_year" ]; then
    printf '%s\n' "$first_year"
    return 0
  fi

  printf '%s-%s\n' "$first_year" "$last_year"
}

package_json_path() {
  if [ -f 'package.json' ]; then
    printf '%s\n' 'package.json'
    return 0
  fi

  return 1
}

package_json_author_default() {
  local package_json_path="$1"

  picotools_require_command perl
  perl -MJSON::PP -0777 -e 'my $path = shift @ARGV; open my $fh, q{<}, $path or die $!; local $/; my $json = <$fh>; my $pkg = JSON::PP->new->decode($json); my $author = $pkg->{author}; if (!defined $author) { exit 0; } if (!ref $author) { print $author; exit 0; } if (ref $author eq q{HASH} && defined $author->{name}) { print $author->{name}; }' "$package_json_path"
}

default_copyright_owner() {
  local package_json_path="${1:-}"

  if [ -z "$package_json_path" ]; then
    return 0
  fi

  package_json_author_default "$package_json_path"
}

update_package_json_license() {
  local package_json_path="$1"
  local license_value="$2"

  picotools_require_command perl
  perl -e '
my ($path, $license) = @ARGV;
open my $fh, q{<}, $path or die $!;
my @lines = <$fh>;
close $fh;

chomp @lines;

my $indent = q{  };
for my $line (@lines) {
  if ($line =~ /^(\s+)"[^"]+"\s*:/) {
    $indent = $1;
    last;
  }
}

sub ensure_trailing_comma {
  my ($lines_ref, $index) = @_;
  $lines_ref->[$index] =~ s/,\s*$//;
  $lines_ref->[$index] .= q{,};
}

my ($license_index, $description_index, $name_index, $open_index) = (-1, -1, -1, -1);

for my $index (0 .. $#lines) {
  my $line = $lines[$index];
  $open_index = $index if $open_index == -1 && $line =~ /^\s*\{\s*$/;
  $license_index = $index if $license_index == -1 && $line =~ /^\Q$indent\E"license"\s*:/;
  $description_index = $index if $description_index == -1 && $line =~ /^\Q$indent\E"description"\s*:/;
  $name_index = $index if $name_index == -1 && $line =~ /^\Q$indent\E"name"\s*:/;
}

if ($license_index != -1) {
  my $has_comma = $lines[$license_index] =~ /,\s*$/ ? q{,} : q{};
  $lines[$license_index] = qq{$indent"license": "$license"$has_comma};
} else {
  if ($description_index == -1) {
    if ($name_index != -1) {
      ensure_trailing_comma(\@lines, $name_index);
      splice @lines, $name_index + 1, 0, qq{$indent"description": ""};
      $description_index = $name_index + 1;
    } else {
      $open_index = 0 if $open_index == -1;
      splice @lines, $open_index + 1, 0, qq{$indent"description": ""};
      $description_index = $open_index + 1;
    }
  }

  ensure_trailing_comma(\@lines, $description_index);

  my $insert_index = $description_index + 1;
  my $has_following_property = 0;
  for my $index ($insert_index .. $#lines) {
    next if $lines[$index] =~ /^\s*$/;
    $has_following_property = $lines[$index] !~ /^\s*\}/ ? 1 : 0;
    last;
  }

  my $comma = $has_following_property ? q{,} : q{};
  splice @lines, $insert_index, 0, qq{$indent"license": "$license"$comma};
}

open my $out, q{>}, $path or die $!;
print {$out} join("\n", @lines), "\n";
close $out;
' "$package_json_path" "$license_value"
}

apache_copyright_line() {
  local package_json_path="${1:-}"
  local provided_year_range="${2:-}"
  local provided_author_name="${3:-}"
  local year_range
  local author_name

  author_name=$(copyright_owner_value "$package_json_path" "$provided_author_name")
  year_range=$(apache_year_range_value "$provided_year_range")

  if [ -n "$year_range" ]; then
    printf 'Copyright %s %s\n' "$year_range" "$author_name"
    return 0
  fi

  printf 'Copyright %s\n' "$author_name"
}

apache_year_range_value() {
  local provided_year_range="${1:-}"
  local years_selection=''

  if [ -n "$provided_year_range" ]; then
    printf '%s\n' "$provided_year_range"
    return 0
  fi

  years_selection=$(picotools_prompt_select_value 'Copyright Years' 'Select years source' 1 \
    'No years' \
    'Use git history' \
    'Enter manually')

  case "$years_selection" in
  'No years')
    return 0
    ;;
  'Use git history')
    git_year_range
    ;;
  'Enter manually')
    picotools_prompt_value 'Copyright years' '' true
    ;;
  *)
    echo "Error: unsupported years selection '$years_selection'" >&2
    exit 1
    ;;
  esac
}

copyright_owner_value() {
  local package_json_path="${1:-}"
  local provided_author_name="${2:-}"
  local default_author=''

  default_author=$(default_copyright_owner "$package_json_path")

  if [ -n "$provided_author_name" ]; then
    printf '%s\n' "$provided_author_name"
    return 0
  fi

  picotools_prompt_value 'Copyright owner' "$default_author" true
}

apache_license_content() {
  local copyright_line="$1"

  apache_license_template_content | while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = '   Copyright [yyyy] [name of copyright owner]' ]; then
      printf '%s\n' "   $copyright_line"
    else
      printf '%s\n' "$line"
    fi
  done
}

write_license_file() {
  local license_type="$1"
  local output_path="$2"
  local copyright_owner="${3:-}"
  local apache_copyright="${4:-}"

  case "$license_type" in
  mit)
    mit_license_content "$copyright_owner" >"$output_path"
    ;;
  apache-2.0)
    apache_license_content "$apache_copyright" >"$output_path"
    ;;
  *)
    echo "Error: unsupported license type '$license_type'" >&2
    exit 1
    ;;
  esac
}

confirm_overwrite() {
  local output_path="$1"

  if [ "$(picotools_prompt_yes_no "Overwrite existing file '$output_path'?" no)" = 'yes' ]; then
    return 0
  fi

  picotools_cancel
  exit 1
}

main() {
  local output_path='LICENSE'
  local assume_yes=false
  local license_type=''
  local license_value=''
  local output_dir
  local package_json=''
  local apache_copyright=''
  local copyright_owner=''
  local copyright_years=''
  local resolved_copyright_owner=''

  while [ $# -gt 0 ]; do
    case "$1" in
    --type)
      if [ $# -lt 2 ]; then
        echo "Error: missing value for $1" >&2
        exit 1
      fi
      license_type=$(normalize_license_type "$2")
      shift 2
      ;;
    --type=*)
      license_type=$(normalize_license_type "${1#*=}")
      shift
      ;;
    --copyright-owner | --owner)
      if [ $# -lt 2 ]; then
        echo "Error: missing value for $1" >&2
        exit 1
      fi
      copyright_owner="$2"
      shift 2
      ;;
    --copyright-owner=* | --owner=*)
      copyright_owner="${1#*=}"
      shift
      ;;
    --copyright-years | --years)
      if [ $# -lt 2 ]; then
        echo "Error: missing value for $1" >&2
        exit 1
      fi
      copyright_years="$2"
      shift 2
      ;;
    --copyright-years=* | --years=*)
      copyright_years="${1#*=}"
      shift
      ;;
    --yes)
      assume_yes=true
      shift
      ;;
    --debug)
      debug_mode=true
      shift
      ;;
    -h | --help | help)
      usage
      exit 0
      ;;
    -v | --version | version)
      print_version
      exit 0
      ;;
    -*)
      echo "Error: unexpected option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ "$output_path" != 'LICENSE' ]; then
        echo "Error: unexpected argument: $1" >&2
        usage >&2
        exit 1
      fi
      output_path="$1"
      shift
      ;;
    esac
  done

  output_dir=$(dirname "$output_path")
  if [ ! -d "$output_dir" ]; then
    echo "Error: parent directory not found: $output_dir" >&2
    exit 1
  fi

  if [ -d "$output_path" ]; then
    echo "Error: output path is a directory: $output_path" >&2
    exit 1
  fi

  package_json=$(package_json_path || true)

  if [ -z "$license_type" ]; then
    debug_log 'Prompting for license selection'
    if ! license_type=$(prompt_license_type); then
      picotools_cancel
      exit 1
    fi
  fi

  if [ "$license_type" != 'apache-2.0' ] && [ -n "$copyright_years" ]; then
    echo 'Error: --copyright-years and --years are only supported for Apache License 2.0' >&2
    exit 1
  fi

  if [ "$license_type" = 'apache-2.0' ]; then
    apache_copyright=$(apache_copyright_line "$package_json" "$copyright_years" "$copyright_owner")
  else
    resolved_copyright_owner=$(copyright_owner_value "$package_json" "$copyright_owner")
  fi

  license_value=$(package_json_license_value "$license_type")

  if [ -e "$output_path" ] && [ "$assume_yes" != 'true' ]; then
    debug_log "Existing file detected at '$output_path'"
    confirm_overwrite "$output_path"
  fi

  debug_log "Writing $(license_label "$license_type") to '$output_path'"
  write_license_file "$license_type" "$output_path" "$resolved_copyright_owner" "$apache_copyright"

  if [ -n "$package_json" ]; then
    debug_log "Updating '$package_json' license field"
    update_package_json_license "$package_json" "$license_value"
    printf "Updated '%s' license field to '%s'.\n" "$package_json" "$license_value"
  fi

  picotools_ui_summary 'License Written' \
    "Type: $(license_label "$license_type")" \
    "Path: ${output_path}" \
    "package.json: $([ -n "$package_json" ] && printf 'updated' || printf 'not found')"

  printf "Wrote %s to '%s'.\n" "$(license_label "$license_type")" "$output_path"
}

main "$@"
