#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" \
  box \
  commands \
  git_commit_workspace \
  git_commit_plan \
  git_commit_model \
  git_commit_config \
  git_commit_options \
  git_commit_scope \
  git_commit_hooks \
  git_commit_prompt \
  git_commit_execution \
  git_commit_remote \
  prompt \
  ui \
  version

# shellcheck disable=SC2034
ALLOWED_TYPES='feat fix docs refactor chore perf test ci'
# shellcheck disable=SC2034
PRE_COMMIT_CONFIG_FILE='.pre-commit-config.yaml'
# shellcheck disable=SC2034
MAX_COMMIT_PLAN_CHANGED_FILES_CHARS=250000
# shellcheck disable=SC2034
MAX_COMMIT_PLAN_DIFF_CHARS=50000
# shellcheck disable=SC2034
MAX_COMMIT_PLAN_FILE_DIFF_CHARS=16384
# shellcheck disable=SC2034
MAX_COMMIT_PLAN_ADDED_FILE_BYTES=65536
# shellcheck disable=SC2034
MAX_COMMIT_PLAN_EXISTING_PR_BODY_CHARS=20000
# shellcheck disable=SC2034
MAX_COMMIT_HEADER_LENGTH=100
# shellcheck disable=SC2034
MAX_COMMIT_MODEL_RESPONSE_BYTES=1048576
# shellcheck disable=SC2034
MAX_COMMIT_MODEL_DIAGNOSTIC_BYTES=4096
GIT_COMMIT_TMPFILES=()
# shellcheck disable=SC2034
LAST_RAW_COMMIT_PLAN_RESPONSE=''

usage() {
  cat <<'EOF'
Usage: git-commit [command]

Commands:
  configure  Select the model profile, model, and optional git-api profile to use

Without a command, `git-commit` analyzes the current git workspace, asks the
configured model for conventional commit suggestions, and creates one or more
commits.

Default preview mode validates and prints a planned command preview only. It may
read repository files and call the configured model provider, but it does not
stage files, create commits, push branches, create or update pull requests, or
execute repository-controlled hooks.

`--apply` revalidates the selected path set and content before mutation, then
creates exactly the planned local commits. `--push` pushes only after successful
local commits. `--pr` opens or updates a pull request only after a successful
push. Failures are not rolled back automatically; earlier local commits and any
successful push remain for manual recovery.

`--path` and `--path-file` limit planning, preliminary hook checks, staging, and
commits to exact repository-relative paths. Paths are passed to Git as literal
top-anchored pathspecs, so spaces, shell metacharacters, glob characters,
leading colons, tabs, newlines, and non-ASCII filenames are matched literally.

In `--pr` mode, authentication precedence is: the PAT owned by the repository's
`picotools.gitProfile` marker, then the configured `git-api.profile`, then
`git-api`'s own fallback resolution.

Options:
  -h, --help, help          Show this help message
  -v, --version, version    Show the tool version
  --debug                   Print progress steps to stderr
  --apply                   Stage files and create the generated commit plan
  --push                    Implies --apply and pushes the created commits
  --pr [base-branch]        Implies --apply --push and creates a pull request
  --pre-commit-retries <n>  Retry failed pre-commit checks this many times
  --path PATH               Limit planning and commits to a file or directory; repeatable
  --path-file PATH          Load additional scoped paths from a newline-delimited file; repeatable
  --scope <value>           Override commit scope for generated titles
  --no-scope                Omit scope from generated titles
  --relaxed-plan            Normalize duplicate and uncovered planned files instead of failing

Debug diagnostics:
  Model response excerpts are printed only with --debug. Excerpts redact values
  from TOKEN, SECRET, PASSWORD, PAT, and KEY environment variables, JSON-escape
  terminal/control bytes, and truncate to 4096 bytes by default.

Hook behavior:
  Preview mode does not execute repository-controlled hooks. Apply mode may run
  the repository's executable pre-commit hook as a preliminary check using a
  temporary index containing only the selected paths, then git-commit creates
  isolated commits without invoking git commit hooks. Out-of-scope preliminary
  hook worktree mutations are rejected.

Stale plans and recovery:
  Apply mode fails before committing if selected files or content changed after
  planning, or if the real index is not in the expected empty state. Commit,
  push, and PR failures preserve the completed side effects and print recovery
  guidance instead of resetting local or remote state.

Push and PR topology:
  Pull requests resolve fetch and push repositories separately. Fork heads are
  qualified as <owner>:<branch> when required; same-repository heads keep the
  branch name. Existing-PR lookup and malformed API responses fail closed before
  planning or mutation.

Repository context:
  `git-profile set` and `git-profile clone` record the active profile as the
  local `picotools.gitProfile` Git config value used by `--pr` auth lookup.
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

debug_enabled() {
  [ "${GIT_COMMIT_DEBUG:-false}" = 'true' ]
}

debug_log() {
  if debug_enabled; then
    printf '[git-commit] %s\n' "$1" >&2
  fi
}

cleanup_tmpfiles() {
  if [ "${#GIT_COMMIT_TMPFILES[@]}" -gt 0 ]; then
    rm -f "${GIT_COMMIT_TMPFILES[@]}"
  fi
}

register_tmpfile() {
  GIT_COMMIT_TMPFILES+=("$1")
}

enable_debug_logging() {
  GIT_COMMIT_DEBUG=true
}

require_git_repository() {
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null || true)" != 'true' ]; then
    echo 'Error: git-commit must be run inside a Git repository' >&2
    return 1
  fi
}

require_dependencies() {
  local tool

  for tool in git jq; do
    if ! command -v "$tool" >/dev/null 2>&1; then
      echo "Error: required tool not found: $tool" >&2
      return 1
    fi
  done

  model_profile_command >/dev/null
}

run_commit_tool() {
  local config_values profile model additional_profile additional_model git_api_profile branch scope diff_output plan_json planned_fingerprint scope_override no_scope apply_commits push_commits create_pr pr_base_branch pre_commit_retries debug_mode relaxed_plan current_dir
  local -a config_lines=()
  local -a selected_paths=()
  # shellcheck disable=SC2034
  local -a changed_files=()
  local -A run_options=()
  local -A pr_context=()

  parse_run_options run_options selected_paths "$@" || return $?
  scope_override="${run_options[scope_override]:-}"
  no_scope="${run_options[no_scope]:-false}"
  apply_commits="${run_options[apply_commits]:-false}"
  push_commits="${run_options[push_commits]:-false}"
  create_pr="${run_options[create_pr]:-false}"
  pr_base_branch="${run_options[pr_base_branch]:-}"
  pre_commit_retries="${run_options[pre_commit_retries]:-2}"
  debug_mode="${run_options[debug_mode]:-false}"
  relaxed_plan="${run_options[relaxed_plan]:-false}"

  if [ "$debug_mode" = 'true' ]; then
    enable_debug_logging
  fi

  current_dir=$(pwd -P)
  prepare_workspace_changes changed_files "$pre_commit_retries" "$current_dir" "$apply_commits" "${selected_paths[@]}" || return 1

  config_values=$(load_run_configuration) || return 1
  mapfile -t config_lines <<<"$config_values"
  profile="${config_lines[0]:-}"
  model="${config_lines[1]:-}"
  additional_profile="${config_lines[2]:-}"
  additional_model="${config_lines[3]:-}"
  git_api_profile="${config_lines[4]:-}"
  GIT_COMMIT_GIT_API_TOKEN=''
  GIT_COMMIT_GIT_API_PROFILE="$git_api_profile"
  require_dependencies || return 1
  if [ "$create_pr" = 'true' ]; then
    git_api_command >/dev/null || return 1
    git_profile_command >/dev/null || return 1
    resolve_repository_git_api_auth || return 1
    if [ -n "$GIT_COMMIT_GIT_API_TOKEN" ]; then
      echo 'Pull request auth: current git-profile PAT.'
    elif [ -n "$GIT_COMMIT_GIT_API_PROFILE" ]; then
      echo 'Pull request auth: configured git-api profile.'
    else
      echo 'Pull request auth: git-api fallback resolution.'
    fi
  fi

  debug_log 'Resolving branch and commit scope'
  branch=$(current_branch_name) || return 1
  scope=$(resolve_scope "$branch" "$scope_override" "$no_scope" changed_files) || return 1
  debug_log "Resolved branch '$branch' and scope '${scope:-<none>}'"

  if [ "$create_pr" = 'true' ]; then
    debug_log 'Resolving pull request context before commit planning'
    resolve_pull_request_context "$branch" "$pr_base_branch" pr_context || return 1
    if [ "${pr_context[existing_exists]:-false}" = 'true' ]; then
      debug_log "Found existing open pull request for '$branch' into '${pr_context[base_branch]:-}' before commit planning"
    fi
  fi

  diff_output=$(collect_changes_diff changed_files)
  capture_workspace_fingerprint planned_fingerprint changed_files
  request_validated_commit_plan plan_json "$profile" "$model" "$additional_profile" "$additional_model" "$branch" "$scope" changed_files "$diff_output" "$relaxed_plan" "$create_pr" "${pr_context[base_branch]:-}" "${pr_context[existing_title]:-}" "${pr_context[existing_body]:-}" "${pr_context[existing_exists]:-false}" || return 1
  debug_log 'Printing commit plan preview'
  print_commit_plan "$plan_json" "$scope" changed_files || return 1

  if [ "$apply_commits" = 'true' ]; then
    revalidate_workspace_before_apply changed_files "$planned_fingerprint" "$current_dir" "${selected_paths[@]}" || return 1
    execute_commit_plan "$plan_json" "$scope" changed_files || return 1
    if [ "$push_commits" = 'true' ]; then
      debug_log 'Pushing committed branch'
      if ! push_current_branch "$branch"; then
        report_push_failure
        return 1
      fi
      if [ "$create_pr" = 'true' ]; then
        if ! create_pull_request "$branch" "$plan_json" "$scope" "${pr_context[owner]:-}" "${pr_context[name]:-}" "${pr_context[base_branch]:-}" "${pr_context[head_owner]:-}" "${pr_context[head_ref]:-}" "${pr_context[existing_url]:-}" "${pr_context[existing_number]:-}" "${pr_context[existing_title]:-}" "${pr_context[existing_body]:-}"; then
          report_pull_request_failure
          return 1
        fi
      fi
    fi
  fi
}

main() {
  case "${1:-}" in
  -h | --help | help)
    usage
    exit 0
    ;;
  -v | --version | version)
    print_version
    exit 0
    ;;
  configure)
    shift
    configure_tool "$@"
    ;;
  '' | --debug | --apply | --push | --pr | --pr=* | --pre-commit-retries | --pre-commit-retries=* | --path | --path=* | --path-file | --path-file=* | --scope | --scope=* | --no-scope | --relaxed-plan)
    run_commit_tool "$@"
    ;;
  *)
    echo "Error: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
