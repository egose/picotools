#!/usr/bin/env bash
# shellcheck disable=SC2329 # Helper functions are invoked indirectly through traps and dispatch.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" box commands config debug prompt table ui version

MODEL_PROFILE_LIB_DIR="${SCRIPT_DIR}/../lib/picotools/model-profile"
if [ ! -d "$MODEL_PROFILE_LIB_DIR" ]; then
  MODEL_PROFILE_LIB_DIR="${SCRIPT_DIR}/../../tools/lib/picotools/model-profile"
fi
for MODEL_PROFILE_MODULE in provider token profile http; do
  if [ ! -f "$MODEL_PROFILE_LIB_DIR/${MODEL_PROFILE_MODULE}.sh" ]; then
    echo "Error: missing model-profile module '${MODEL_PROFILE_MODULE}.sh'" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$MODEL_PROFILE_LIB_DIR/${MODEL_PROFILE_MODULE}.sh"
done
unset MODEL_PROFILE_MODULE

usage() {
  cat <<'EOF'
Usage: model-profile [--debug] <command> [--debug] [command options] [--] [operands]

Commands:
  create    Create a saved model profile
  update    Update a saved model profile
  list      List saved model profiles
  read      Prompt for and show details for one saved model profile
  profiles  List saved model profile names
  models    List configured models for a profile
  ask       Send a prompt to a model profile
  test      Send a tiny chat request to test a model profile
  delete    Delete a saved model profile

Options:
  -h, --help, help          Show this help message
  -v, --version, version    Show the tool version
  --debug                   Print request debug steps to stderr

Dependencies:
  Git is required for profile persistence commands. curl and jq are required
  only by request commands: ask and test.

Grammar:
  Global --debug is accepted before or immediately after any command. Commands
  reject unknown options, missing option values, duplicate singleton options,
  extra operands, and conflicting message sources before prompting or storage
  access. The -- separator ends option parsing for command operands; options
  after -- are treated as operands.

Arity:
  create, update, list, read, profiles, delete  No operands
  models <profile>                              Exactly one operand
  ask                                           Interactive prompt
  ask <profile> --message TEXT                  Non-interactive prompt
  ask <profile> --user-message TEXT             Alias for --message
  ask <profile> --message-file PATH             File-backed prompt
  test                                          Interactive connection test
  test <profile>                                Non-interactive connection test

Ask:
  model-profile ask
  model-profile ask <profile> --message TEXT [--model MODEL] [--system-message TEXT]
  model-profile ask <profile> --user-message TEXT [--model MODEL] [--system-message TEXT]
  model-profile ask <profile> --message-file PATH [--model MODEL] [--system-message-file PATH]

Test:
  model-profile test
  model-profile test <profile> [--model MODEL]

Exit status:
  0  Success
  1  Validation, storage, helper, or transport error; no profiles available;
     invalid selection; EOF before required input
  2  Explicit cancellation

Environment:
  MODEL_PROFILE_DEBUG=true                  Deprecated fallback for --debug
  MODEL_PROFILE_CURL_CONNECT_TIMEOUT=<s>    Connect timeout, default 10, max 120
  MODEL_PROFILE_CURL_MAX_TIME=<s>           Total request timeout, default 60, max 600
  MODEL_PROFILE_MAX_PAYLOAD_BYTES=<bytes>   Request payload cap, default 1048576, max 10485760
  MODEL_PROFILE_MAX_RESPONSE_BYTES=<bytes>  Response body cap, default 1048576, max 10485760
  MODEL_PROFILE_MAX_DIAGNOSTIC_BYTES=<bytes> Error diagnostic cap, default 4096, max 65536

HTTP policy:
  Requests ignore .curlrc, do not use proxies, use HTTPS only, and do not
  follow redirects. Message files must be readable regular files; symlinks,
  FIFOs, devices, and other special files are rejected.

Storage policy:
  Profile metadata is stored under ${XDG_CONFIG_HOME:-$HOME/.config}/model-profile
  and API keys under ${XDG_DATA_HOME:-$HOME/.local/share}/model-profile. API key
  reads fail closed unless the key directory is mode 0700 and key files are
  mode 0600. create, update, and delete stage complete validated state before
  same-directory atomic publication and roll back on token/profile failures.

Custom endpoints:
  Must be HTTPS URLs with a DNS hostname or public IPv4 literal. Userinfo,
  fragments, query strings, HTTP, localhost, private, loopback, and link-local
  address literals are rejected before API keys are read.
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

debug_mode=false
MODEL_PROFILE_TMPFILES=()
MODEL_PROFILE_EXPLICIT_DEBUG=false
MODEL_PROFILE_CLI_COMMAND=''
MODEL_PROFILE_CLI_PROFILE_NAME=''
MODEL_PROFILE_CLI_MODEL=''
MODEL_PROFILE_CLI_INTERACTIVE=false
MODEL_PROFILE_CLI_USER_MESSAGE=''
MODEL_PROFILE_CLI_USER_MESSAGE_FILE=''
MODEL_PROFILE_CLI_SYSTEM_MESSAGE='You are a helpful assistant.'
MODEL_PROFILE_CLI_SYSTEM_MESSAGE_FILE=''

enable_debug_logging() {
  debug_mode=true
  MODEL_PROFILE_EXPLICIT_DEBUG=true
}

legacy_debug_enabled() {
  [ "${MODEL_PROFILE_DEBUG:-false}" = 'true' ]
}

debug_enabled() {
  [ "$debug_mode" = 'true' ] || legacy_debug_enabled
}

debug_log() {
  if debug_enabled; then
    picotools_debug_log 'model-profile' "$1"
  fi
}

print_model_profile_table() {
  local header_row="$1"
  shift
  local -a rows=("$@")
  local -a headers=() widths=() fields=()
  local row index value padding

  if picotools_table_stderr_is_pretty; then
    picotools_print_table "$header_row" "${rows[@]}"
    return 0
  fi

  IFS=$'\t' read -r -a headers <<<"$header_row"
  for index in "${!headers[@]}"; do
    widths[index]=${#headers[index]}
  done

  for row in "${rows[@]}"; do
    IFS=$'\t' read -r -a fields <<<"$row"
    for index in "${!headers[@]}"; do
      value=${fields[index]:-}
      if [ "${#value}" -gt "${widths[index]}" ]; then
        widths[index]=${#value}
      fi
    done
  done

  for index in "${!headers[@]}"; do
    padding=$(printf '%*s' "$((widths[index] + 2))" '')
    printf '+%s' "${padding// /-}"
  done
  printf '+\n'

  for index in "${!headers[@]}"; do
    printf '| %s' "${headers[index]}"
    printf '%*s ' "$((widths[index] - ${#headers[index]}))" ''
  done
  printf '|\n'

  for index in "${!headers[@]}"; do
    padding=$(printf '%*s' "$((widths[index] + 2))" '')
    printf '+%s' "${padding// /-}"
  done
  printf '+\n'

  for row in "${rows[@]}"; do
    IFS=$'\t' read -r -a fields <<<"$row"
    for index in "${!headers[@]}"; do
      value=${fields[index]:-}
      printf '| %s' "$value"
      printf '%*s ' "$((widths[index] - ${#value}))" ''
    done
    printf '|\n'
  done

  for index in "${!headers[@]}"; do
    padding=$(printf '%*s' "$((widths[index] + 2))" '')
    printf '+%s' "${padding// /-}"
  done
  printf '+\n'
}

print_model_profile_two_column_table() {
  print_model_profile_table $'Field\tValue' "$@"
}

cleanup_tmpfiles() {
  if [ "${#MODEL_PROFILE_TMPFILES[@]}" -gt 0 ]; then
    rm -rf "${MODEL_PROFILE_TMPFILES[@]}"
  fi
}

register_tmpfile() {
  MODEL_PROFILE_TMPFILES+=("$1")
}

cleanup_tmpfiles_on_signal() {
  local signal="$1"

  transaction_rollback_active || true
  cleanup_tmpfiles
  trap - EXIT "$signal"
  kill -s "$signal" "$$"
}

trap 'cleanup_tmpfiles' EXIT
trap 'cleanup_tmpfiles_on_signal HUP' HUP
trap 'cleanup_tmpfiles_on_signal INT' INT
trap 'cleanup_tmpfiles_on_signal TERM' TERM

warn_deprecated_debug_env() {
  if legacy_debug_enabled && [ "$MODEL_PROFILE_EXPLICIT_DEBUG" != true ]; then
    echo 'Warning: MODEL_PROFILE_DEBUG is deprecated; use --debug instead.' >&2
  fi
}

cli_error() {
  echo "Error: $1" >&2
}

cli_missing_value() {
  cli_error "$1 requires a value"
}

cli_reject_no_arg_command_args() {
  local command="$1"
  shift
  local parsing_options=true

  while [ "$#" -gt 0 ]; do
    if [ "$parsing_options" = true ]; then
      case "$1" in
      --debug)
        enable_debug_logging
        shift
        continue
        ;;
      --)
        parsing_options=false
        shift
        continue
        ;;
      --*)
        cli_error "unknown $command option '$1'"
        return 1
        ;;
      esac
    fi

    cli_error "$command does not accept operands: $1"
    return 1
  done
}

parse_models_cli() {
  local parsing_options=true

  while [ "$#" -gt 0 ]; do
    if [ "$parsing_options" = true ]; then
      case "$1" in
      --debug)
        enable_debug_logging
        shift
        continue
        ;;
      --)
        parsing_options=false
        shift
        continue
        ;;
      --*)
        cli_error "unknown models option '$1'"
        return 1
        ;;
      esac
    fi

    if [ -n "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
      cli_error "models accepts exactly one profile operand"
      return 1
    fi
    MODEL_PROFILE_CLI_PROFILE_NAME="$1"
    shift
  done

  if [ -z "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
    cli_error 'models requires a profile name'
    return 1
  fi
}

parse_test_cli() {
  local parsing_options=true seen_model=false saw_cli_arg=false

  while [ "$#" -gt 0 ]; do
    if [ "$parsing_options" = true ]; then
      case "$1" in
      --debug)
        enable_debug_logging
        shift
        continue
        ;;
      --model)
        saw_cli_arg=true
        if [ "$#" -lt 2 ]; then
          cli_missing_value --model
          return 1
        fi
        if [ "$seen_model" = true ]; then
          cli_error 'duplicate --model option'
          return 1
        fi
        seen_model=true
        MODEL_PROFILE_CLI_MODEL="$2"
        shift 2
        continue
        ;;
      --)
        parsing_options=false
        shift
        continue
        ;;
      --*)
        cli_error "unknown test option '$1'"
        return 1
        ;;
      esac
    fi

    saw_cli_arg=true
    if [ -n "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
      cli_error "test accepts exactly one profile operand"
      return 1
    fi
    MODEL_PROFILE_CLI_PROFILE_NAME="$1"
    shift
  done

  if [ -z "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
    if [ "$saw_cli_arg" = true ]; then
      cli_error 'test requires a profile name when options are provided'
      return 1
    fi
    MODEL_PROFILE_CLI_INTERACTIVE=true
  fi
}

parse_ask_cli() {
  local parsing_options=true seen_model=false seen_system=false seen_user=false saw_cli_arg=false option

  while [ "$#" -gt 0 ]; do
    if [ "$parsing_options" = true ]; then
      case "$1" in
      --debug)
        enable_debug_logging
        shift
        continue
        ;;
      --model)
        saw_cli_arg=true
        if [ "$#" -lt 2 ]; then
          cli_missing_value --model
          return 1
        fi
        if [ "$seen_model" = true ]; then
          cli_error 'duplicate --model option'
          return 1
        fi
        seen_model=true
        MODEL_PROFILE_CLI_MODEL="$2"
        shift 2
        continue
        ;;
      --system-message | --system-message-file)
        saw_cli_arg=true
        option="$1"
        if [ "$#" -lt 2 ]; then
          cli_missing_value "$option"
          return 1
        fi
        if [ "$seen_system" = true ]; then
          cli_error 'conflicting or duplicate system message options'
          return 1
        fi
        seen_system=true
        if [ "$option" = '--system-message' ]; then
          MODEL_PROFILE_CLI_SYSTEM_MESSAGE="$2"
          MODEL_PROFILE_CLI_SYSTEM_MESSAGE_FILE=''
        else
          MODEL_PROFILE_CLI_SYSTEM_MESSAGE=''
          MODEL_PROFILE_CLI_SYSTEM_MESSAGE_FILE="$2"
        fi
        shift 2
        continue
        ;;
      --message | --user-message | --message-file | --user-message-file)
        saw_cli_arg=true
        option="$1"
        if [ "$#" -lt 2 ]; then
          cli_missing_value "$option"
          return 1
        fi
        if [ "$seen_user" = true ]; then
          cli_error 'conflicting or duplicate user message options'
          return 1
        fi
        seen_user=true
        if [ "$option" = '--message' ] || [ "$option" = '--user-message' ]; then
          MODEL_PROFILE_CLI_USER_MESSAGE="$2"
          MODEL_PROFILE_CLI_USER_MESSAGE_FILE=''
        else
          MODEL_PROFILE_CLI_USER_MESSAGE=''
          MODEL_PROFILE_CLI_USER_MESSAGE_FILE="$2"
        fi
        shift 2
        continue
        ;;
      --)
        parsing_options=false
        shift
        continue
        ;;
      --*)
        cli_error "unknown ask option '$1'"
        return 1
        ;;
      esac
    fi

    saw_cli_arg=true
    if [ -n "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
      cli_error "ask accepts exactly one profile operand"
      return 1
    fi
    MODEL_PROFILE_CLI_PROFILE_NAME="$1"
    shift
  done

  if [ -z "$MODEL_PROFILE_CLI_PROFILE_NAME" ]; then
    if [ "$saw_cli_arg" = true ]; then
      cli_error 'ask requires a profile name when options are provided'
      return 1
    fi
    MODEL_PROFILE_CLI_INTERACTIVE=true
    return 0
  fi

  if [ "$seen_user" != true ]; then
    cli_error 'ask requires --message, --user-message, --message-file, or --user-message-file'
    return 1
  fi
}

parse_model_profile_cli() {
  MODEL_PROFILE_EXPLICIT_DEBUG=false
  MODEL_PROFILE_CLI_COMMAND=''
  MODEL_PROFILE_CLI_PROFILE_NAME=''
  MODEL_PROFILE_CLI_MODEL=''
  MODEL_PROFILE_CLI_INTERACTIVE=false
  MODEL_PROFILE_CLI_USER_MESSAGE=''
  MODEL_PROFILE_CLI_USER_MESSAGE_FILE=''
  MODEL_PROFILE_CLI_SYSTEM_MESSAGE='You are a helpful assistant.'
  MODEL_PROFILE_CLI_SYSTEM_MESSAGE_FILE=''

  while [ "${1:-}" = '--debug' ]; do
    enable_debug_logging
    shift
  done

  case "${1:-}" in
  -h | --help | help | '')
    MODEL_PROFILE_CLI_COMMAND=help
    [ "$#" -le 1 ] || {
      cli_error 'help does not accept operands'
      return 1
    }
    ;;
  -v | --version | version)
    MODEL_PROFILE_CLI_COMMAND=version
    [ "$#" -le 1 ] || {
      cli_error 'version does not accept operands'
      return 1
    }
    ;;
  create | update | list | read | profiles | delete)
    MODEL_PROFILE_CLI_COMMAND="$1"
    shift
    cli_reject_no_arg_command_args "$MODEL_PROFILE_CLI_COMMAND" "$@" || return 1
    ;;
  models)
    MODEL_PROFILE_CLI_COMMAND=models
    shift
    parse_models_cli "$@" || return 1
    ;;
  ask)
    MODEL_PROFILE_CLI_COMMAND=ask
    shift
    parse_ask_cli "$@" || return 1
    ;;
  test)
    MODEL_PROFILE_CLI_COMMAND='test'
    shift
    parse_test_cli "$@" || return 1
    ;;
  *)
    cli_error "unknown command '$1'"
    return 1
    ;;
  esac
}

prompt_provider_type() {
  local current_value="${1:-}"
  local selection default_selection provider_type
  local status
  local -a labels=()

  default_selection=$(provider_type_default_selection "$current_value")
  while IFS= read -r provider_type; do
    labels+=("$provider_type")
  done <<<"$(provider_prompt_labels)"

  while true; do
    if selection=$(picotools_prompt_select_index 'Provider types' 'Select provider type' "$default_selection" false "${labels[@]}"); then
      :
    else
      status=$?
      if [ "$status" -eq 2 ]; then
        return 2
      fi

      echo 'Please choose 1, 2, 3, or 4.' >&2
      continue
    fi

    if provider_type=$(provider_type_from_selection "$selection"); then
      printf '%s\n' "$provider_type"
      return 0
    fi

    echo 'Please choose 1, 2, 3, or 4.' >&2
  done
}

prompt_profile_fields() {
  local provider_type="$1"
  local current_resource_name="${2:-}"
  local current_endpoint_url="${3:-}"
  local current_models="${4:-}"
  local resource_name='' endpoint_url='' models=''

  if provider_has_resource_name "$provider_type"; then
    resource_name=$(picotools_prompt_value 'Resource name' "$current_resource_name" true)
    resource_name=$(trim_spaces "$resource_name")
  fi

  if provider_has_endpoint_url "$provider_type"; then
    endpoint_url=$(picotools_prompt_value 'Endpoint URL' "$current_endpoint_url" true)
    endpoint_url=$(normalize_endpoint_url_value "$endpoint_url")
  fi

  models=$(picotools_prompt_value 'Models (comma-separated)' "$current_models" true)
  models=$(normalize_models_value "$models")

  if ! validate_profile_schema_values candidate "$provider_type" "$resource_name" "$endpoint_url" "$models"; then
    return 1
  fi

  printf '%s\001%s\001%s\n' "$resource_name" "$endpoint_url" "$models"
}

select_profile_file() {
  local file name files_output selection status
  local files=()
  local names=()

  if files_output=$(saved_profile_files); then
    :
  else
    status=$?
    if [ "$status" -ne 1 ]; then
      return 1
    fi
    files_output=''
  fi

  while IFS= read -r file; do
    if [ -z "$file" ]; then
      continue
    fi
    files+=("$file")
    name=$(profile_name_from_file "$file")
    names+=("$name")
  done <<<"$files_output"

  if [ "${#names[@]}" -eq 0 ]; then
    echo 'No model profiles found.' >&2
    return 1
  fi

  if selection=$(picotools_prompt_select_index 'Profiles' 'Select profile' '' false "${names[@]}"); then
    printf '%s\n' "${files[$((selection - 1))]}"
    return 0
  else
    status=$?
    return "$status"
  fi
}

format_profile_summary_row() {
  local file="$1"
  local index="$2"
  local name provider_type resource_name endpoint_url location models token_status status

  read_valid_profile_record "$file" name provider_type resource_name endpoint_url models || return 1
  location="$resource_name"
  if [ -z "$location" ]; then
    location="$endpoint_url"
  fi

  if token_exists "$name"; then
    token_status=yes
  else
    status=$?
    if [ "$status" -ne 1 ]; then
      return 1
    fi
    token_status=no
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$index" \
    "$name" \
    "$(provider_type_label "$provider_type")" \
    "$(display_value "$location")" \
    "$(display_value "$models")" \
    "$token_status"
}

print_profile_detail() {
  local file="$1"
  local name provider_type resource_name endpoint_url endpoint models token_status token_path status

  read_valid_profile_record "$file" name provider_type resource_name endpoint_url models || return 1
  endpoint=$(provider_endpoint "$provider_type" "$resource_name" "$endpoint_url")
  token_path=$(token_file "$name")

  if token_exists "$name"; then
    token_status=yes
  else
    status=$?
    if [ "$status" -ne 1 ]; then
      return 1
    fi
    token_status=no
  fi

  print_model_profile_two_column_table \
    $'Name	'"$name" \
    $'Type	'"$(provider_type_label "$provider_type")" \
    $'Resource Name	'"$(display_value "$resource_name")" \
    $'Endpoint URL	'"$(display_value "$endpoint_url")" \
    $'Endpoint	'"$(display_value "$endpoint")" \
    $'Models	'"$(display_value "$models")" \
    $'Token Stored	'"$token_status" \
    $'Config File	'"$file" \
    $'Token File	'"$token_path"
}

create_profile() {
  local name file overwrite provider_type token resource_name endpoint_url models selected_fields status

  picotools_ui_section 'Create Model Profile'
  picotools_ui_step 1 3 'Name the profile'
  name=$(picotools_prompt_value 'Profile name' '' true)
  validate_profile_name "$name"
  ensure_storage_dirs
  file=$(require_writable_profile_file "$name") || return 1

  if [ -f "$file" ]; then
    overwrite=$(picotools_prompt_yes_no "Profile '$name' already exists. Overwrite?" no)
    if [ "$overwrite" != 'yes' ]; then
      picotools_cancel
      return 2
    fi
  fi

  if provider_type=$(prompt_provider_type); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    picotools_cancel
    return 1
  fi
  picotools_ui_step 2 3 'Choose provider and models'
  selected_fields=$(prompt_profile_fields "$provider_type") || return 1
  IFS=$'\001' read -r resource_name endpoint_url models <<<"$selected_fields"
  token=$(picotools_prompt_secret_value 'API key' '' true)

  picotools_ui_step 3 3 'Save profile credentials'
  picotools_ui_summary 'Review Model Profile' \
    "Profile: ${name}" \
    "Provider: $(provider_type_label "$provider_type")" \
    "Models: ${models}"
  if ! publish_profile_transaction "$name" "$file" "$provider_type" "$resource_name" "$endpoint_url" "$models" write "$token"; then
    return 1
  fi
  picotools_ui_summary 'Model Profile Saved' \
    "Profile: ${name}" \
    "Provider: $(provider_type_label "$provider_type")" \
    "Models: ${models}"
  echo "Saved model profile '$name'."
}

list_profiles() {
  local file files_output row status
  local index=1
  local -a rows=()

  if files_output=$(saved_profile_files); then
    :
  else
    status=$?
    if [ "$status" -ne 1 ]; then
      return 1
    fi
    echo 'No model profiles found.'
    return 0
  fi

  while IFS= read -r file; do
    row=$(format_profile_summary_row "$file" "$index") || return 1
    rows+=("$row")
    index=$((index + 1))
  done <<<"$files_output"

  print_model_profile_table $'#	Name	Type	Resource	Models	Token' "${rows[@]}"
}

read_profile() {
  local file status

  if file=$(select_profile_file); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    return 1
  fi
  print_profile_detail "$file"
}

list_profile_names() {
  local file files_output status

  if files_output=$(saved_profile_files); then
    :
  else
    status=$?
    if [ "$status" -ne 1 ]; then
      return 1
    fi
    return 0
  fi

  while IFS= read -r file; do
    profile_name_from_file "$file"
  done <<<"$files_output"
}

list_profile_models() {
  local profile_name="${1:-}"
  local file name provider_type resource_name endpoint_url model_list
  local model_item
  local -a model_items=()

  if [ -z "$profile_name" ]; then
    echo 'Error: models requires a profile name' >&2
    exit 1
  fi

  file=$(require_existing_profile_file "$profile_name") || return 1
  read_valid_profile_record "$file" name provider_type resource_name endpoint_url model_list || return 1
  IFS=',' read -r -a model_items <<<"$model_list"

  for model_item in "${model_items[@]}"; do
    printf '%s\n' "$model_item"
  done
}

update_profile_file() {
  local file="$1"
  local name provider_type resource_name endpoint_url models selected_fields
  local update_token token status

  require_valid_profile_file "$file" || return 1
  name=$(profile_name_from_file "$file")
  picotools_ui_section 'Update Model Profile'
  picotools_ui_step 1 2 'Choose provider settings'
  provider_type=$(read_profile_value "$file" provider.type)
  resource_name=$(provider_resource_name_value "$file")
  endpoint_url=$(provider_endpoint_url_value "$file")
  models=$(provider_models_value "$file")

  if provider_type=$(prompt_provider_type "$provider_type"); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    picotools_cancel
    return 1
  fi
  selected_fields=$(prompt_profile_fields "$provider_type" "$resource_name" "$endpoint_url" "$models") || return 1
  IFS=$'\001' read -r resource_name endpoint_url models <<<"$selected_fields"

  picotools_ui_step 2 2 'Review and save token changes'
  update_token=$(picotools_prompt_yes_no 'Update API key?' no)
  if [ "$update_token" = 'yes' ]; then
    token=$(picotools_prompt_secret_value 'API key' '' true)
  else
    token=''
  fi

  picotools_ui_summary 'Review Updated Model Profile' \
    "Profile: ${name}" \
    "Provider: $(provider_type_label "$provider_type")" \
    "Models: ${models}" \
    "Token updated: ${update_token}"

  if [ "$update_token" = 'yes' ]; then
    if ! publish_profile_transaction "$name" "$file" "$provider_type" "$resource_name" "$endpoint_url" "$models" write "$token"; then
      return 1
    fi
  else
    if ! publish_profile_transaction "$name" "$file" "$provider_type" "$resource_name" "$endpoint_url" "$models" keep; then
      return 1
    fi
  fi

  picotools_ui_summary 'Model Profile Updated' \
    "Profile: ${name}" \
    "Provider: $(provider_type_label "$provider_type")" \
    "Models: ${models}"
  echo "Updated model profile '$name'."
}

delete_profile_file() {
  local file="$1"
  local name confirm

  require_valid_profile_file "$file" || return 1
  name=$(profile_name_from_file "$file")
  confirm=$(picotools_prompt_yes_no "Delete '$name'?" no)
  if [ "$confirm" != 'yes' ]; then
    picotools_cancel
    return 2
  fi

  picotools_ui_summary 'Review Model Profile Deletion' \
    "Profile: ${name}" \
    'Token file: will be removed'

  if ! delete_profile_transaction "$name" "$file"; then
    return 1
  fi
  picotools_ui_status ok "Deleted model profile '${name}'"
  echo 'Deleted model profile.'
}

update_profile() {
  local file status

  if file=$(select_profile_file); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    return 1
  fi
  update_profile_file "$file"
}

delete_profile() {
  local file status

  if file=$(select_profile_file); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    return 1
  fi
  delete_profile_file "$file"
}

ask_provider_interactive() {
  local file model status system_message user_message

  require_ask_tools
  picotools_ui_section 'Ask Model'
  picotools_ui_step 1 2 'Choose profile and model'
  if file=$(select_profile_file); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    return 1
  fi
  if model=$(select_profile_model "$file"); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
    fi
    return "$status"
  fi
  picotools_ui_step 2 2 'Enter prompt content'
  system_message=$(picotools_prompt_value 'System message' 'You are a helpful assistant.')
  user_message=$(picotools_prompt_value 'User message' '' true)
  provider_chat_completion "$file" "$model" "$system_message" "$user_message"
}

ask_provider_cli() {
  local profile_name="$MODEL_PROFILE_CLI_PROFILE_NAME"
  local file model="$MODEL_PROFILE_CLI_MODEL"
  local system_message="$MODEL_PROFILE_CLI_SYSTEM_MESSAGE"
  local user_message="$MODEL_PROFILE_CLI_USER_MESSAGE"
  local system_message_file="$MODEL_PROFILE_CLI_SYSTEM_MESSAGE_FILE"
  local user_message_file="$MODEL_PROFILE_CLI_USER_MESSAGE_FILE"

  if [ -n "$system_message_file" ]; then
    require_safe_message_file "$system_message_file" system
  fi
  if [ -n "$user_message_file" ]; then
    require_safe_message_file "$user_message_file" user
  fi

  require_ask_tools
  file=$(require_existing_profile_file "$profile_name") || return 1

  if [ -n "$model" ]; then
    if ! profile_has_model "$file" "$model"; then
      echo "Error: model not configured for profile '$profile_name': $model" >&2
      return 1
    fi
  else
    model=$(default_profile_model "$file") || return 1
  fi

  provider_chat_completion "$file" "$model" "$system_message" "$user_message" "$system_message_file" "$user_message_file"
}

ask_provider() {
  if [ "$MODEL_PROFILE_CLI_INTERACTIVE" = true ]; then
    ask_provider_interactive
    return $?
  fi

  ask_provider_cli
}

connection_test_system_message() {
  printf '%s\n' 'You are a connection test. Reply with the single word OK.'
}

connection_test_user_message() {
  printf '%s\n' 'Reply with OK.'
}

print_connection_test_result() {
  local file="$1"
  local model="$2"
  local response="$3"
  local name provider_type resource_name endpoint_url endpoint

  name=$(profile_name_from_file "$file")
  provider_type=$(read_profile_value "$file" provider.type)
  resource_name=$(provider_resource_name_value "$file")
  endpoint_url=$(provider_endpoint_url_value "$file")
  endpoint=$(provider_endpoint "$provider_type" "$resource_name" "$endpoint_url")

  picotools_print_two_column_table \
    $'Profile	'"$name" \
    $'Type	'"$(provider_type_label "$provider_type")" \
    $'Endpoint	'"$(display_value "$endpoint")" \
    $'Model	'"$model" \
    $'Status	OK' \
    $'Response	'"$response"
}

test_profile_file() {
  local file="$1"
  local model="$2"
  local response

  response=$(provider_chat_completion "$file" "$model" "$(connection_test_system_message)" "$(connection_test_user_message)") || return 1
  print_connection_test_result "$file" "$model" "$response"
}

test_profile_interactive() {
  local file model status

  require_ask_tools
  if file=$(select_profile_file); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
      return 2
    fi
    return 1
  fi
  if model=$(select_profile_model "$file"); then
    :
  else
    status=$?
    if [ "$status" -eq 2 ]; then
      picotools_cancel
    fi
    return "$status"
  fi

  test_profile_file "$file" "$model"
}

test_profile_cli() {
  local profile_name="$MODEL_PROFILE_CLI_PROFILE_NAME"
  local file model="$MODEL_PROFILE_CLI_MODEL"

  require_ask_tools
  file=$(require_existing_profile_file "$profile_name") || return 1

  if [ -n "$model" ]; then
    if ! profile_has_model "$file" "$model"; then
      echo "Error: model not configured for profile '$profile_name': $model" >&2
      return 1
    fi
  else
    model=$(default_profile_model "$file") || return 1
  fi

  test_profile_file "$file" "$model"
}

test_profile() {
  if [ "$MODEL_PROFILE_CLI_INTERACTIVE" = true ]; then
    test_profile_interactive
    return $?
  fi

  test_profile_cli
}

main() {
  if ! parse_model_profile_cli "$@"; then
    exit 1
  fi

  warn_deprecated_debug_env

  case "$MODEL_PROFILE_CLI_COMMAND" in
  help)
    usage
    exit 0
    ;;
  version)
    print_version
    exit 0
    ;;
  create)
    create_profile
    ;;
  update)
    update_profile
    ;;
  list)
    list_profiles
    ;;
  read)
    read_profile
    ;;
  profiles)
    list_profile_names
    ;;
  models)
    list_profile_models "$MODEL_PROFILE_CLI_PROFILE_NAME"
    ;;
  ask)
    ask_provider
    ;;
  test)
    test_profile
    ;;
  delete)
    delete_profile
    ;;
  esac

  exit 0
}

main "$@"
