#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" commands version

debug_mode=false
target_dir='.github'
forced_ref_type=''
GH_ACTIONS_UPGRADE_TMPDIR=''
GH_ACTIONS_UPGRADE_CHANGES_FILE=''

declare -A GH_ACTIONS_UPGRADE_LATEST_TAGS=()
declare -A GH_ACTIONS_UPGRADE_LATEST_HASHES=()

usage() {
  cat <<'EOF'
Usage: gh-actions-upgrade [--ref-type tag|hash] [github-dir]

Updates GitHub Action `uses:` refs under .github YAML files to each action's
latest available version.

By default, each action keeps its current ref style:
- tag refs update to the latest tag
- commit-hash refs update to the commit hash for the latest tag

Options:
  --ref-type TYPE            Force all action refs to `tag` or `hash`
  --debug                    Print progress details to stderr
  -h, --help, help           Show this help message
  -v, --version, version     Show the tool version

Arguments:
  github-dir                 Directory to scan (default: ./.github)
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

debug_enabled() {
  [ "$debug_mode" = 'true' ]
}

debug_log() {
  if debug_enabled; then
    printf '[gh-actions-upgrade] %s\n' "$1" >&2
  fi
}

cleanup_tmpdir() {
  if [ -n "$GH_ACTIONS_UPGRADE_TMPDIR" ] && [ -d "$GH_ACTIONS_UPGRADE_TMPDIR" ]; then
    rm -rf "$GH_ACTIONS_UPGRADE_TMPDIR"
  fi
}

ensure_tmpdir() {
  if [ -n "$GH_ACTIONS_UPGRADE_TMPDIR" ] && [ -d "$GH_ACTIONS_UPGRADE_TMPDIR" ]; then
    return 0
  fi

  GH_ACTIONS_UPGRADE_TMPDIR=$(mktemp -d)
  GH_ACTIONS_UPGRADE_CHANGES_FILE="$GH_ACTIONS_UPGRADE_TMPDIR/changes.txt"
  : >"$GH_ACTIONS_UPGRADE_CHANGES_FILE"
  trap 'cleanup_tmpdir' EXIT
}

trim_trailing_whitespace() {
  local value="$1"

  value="${value%"${value##*[![:space:]]}"}"
  printf '%s\n' "$value"
}

is_commit_hash_ref() {
  [[ "$1" =~ ^[0-9a-fA-F]{40}$ ]]
}

is_stable_version_tag() {
  [[ "$1" =~ ^v?[0-9]+([.][0-9]+)*$ ]]
}

github_token_optional() {
  if [ -n "${GH_TOKEN:-}" ]; then
    printf '%s\n' "$GH_TOKEN"
    return 0
  fi

  if [ -n "${GITHUB_TOKEN:-}" ]; then
    printf '%s\n' "$GITHUB_TOKEN"
    return 0
  fi

  if [ -n "${GITHUB_PAT:-}" ]; then
    printf '%s\n' "$GITHUB_PAT"
    return 0
  fi

  if [ -n "${PAT_TOKEN:-}" ]; then
    printf '%s\n' "$PAT_TOKEN"
    return 0
  fi

  printf '\n'
}

repo_remote_url() {
  printf 'https://github.com/%s.git\n' "$1"
}

cache_latest_action_version() {
  local repo="$1"
  local remote_url output hash ref tag latest_tag='' latest_hash='' token
  local -a git_command=()
  local -a tags=()
  local -a stable_tags=()
  local -A direct_hashes=()
  local -A peeled_hashes=()
  local -A seen_tags=()

  if [ -n "${GH_ACTIONS_UPGRADE_LATEST_TAGS[$repo]:-}" ]; then
    return 0
  fi

  remote_url=$(repo_remote_url "$repo")
  token=$(github_token_optional)
  debug_log "Fetching tags for '$repo'"
  git_command=(git ls-remote --tags "$remote_url")
  if [ -n "$token" ]; then
    debug_log "Using authenticated git tag lookup for '$repo'"
    git_command=(git -c "http.extraHeader=Authorization: Bearer $token" ls-remote --tags "$remote_url")
  fi
  output=$("${git_command[@]}")

  while IFS=$'\t' read -r hash ref; do
    [ -n "$hash" ] || continue
    case "$ref" in
    refs/tags/*^{})
      tag=${ref#refs/tags/}
      tag=${tag%^\{\}}
      peeled_hashes["$tag"]="$hash"
      if [ -z "${seen_tags[$tag]:-}" ]; then
        tags+=("$tag")
        seen_tags["$tag"]=1
        if is_stable_version_tag "$tag"; then
          stable_tags+=("$tag")
        fi
      fi
      ;;
    refs/tags/*)
      tag=${ref#refs/tags/}
      direct_hashes["$tag"]="$hash"
      if [ -z "${seen_tags[$tag]:-}" ]; then
        tags+=("$tag")
        seen_tags["$tag"]=1
        if is_stable_version_tag "$tag"; then
          stable_tags+=("$tag")
        fi
      fi
      ;;
    esac
  done <<<"$output"

  if [ "${#tags[@]}" -eq 0 ]; then
    echo "Error: no tags found for GitHub Action repository '$repo'" >&2
    exit 1
  fi

  if [ "${#stable_tags[@]}" -gt 0 ]; then
    debug_log "Selecting latest stable tag for '$repo'"
    while IFS= read -r tag; do
      latest_tag="$tag"
    done < <(printf '%s\n' "${stable_tags[@]}" | LC_ALL=C sort -V)
  else
    while IFS= read -r tag; do
      latest_tag="$tag"
    done < <(printf '%s\n' "${tags[@]}" | LC_ALL=C sort -V)
  fi

  latest_hash=${peeled_hashes[$latest_tag]:-${direct_hashes[$latest_tag]:-}}
  if [ -z "$latest_hash" ]; then
    echo "Error: unable to resolve commit hash for latest tag '$latest_tag' in '$repo'" >&2
    exit 1
  fi

  GH_ACTIONS_UPGRADE_LATEST_TAGS["$repo"]="$latest_tag"
  GH_ACTIONS_UPGRADE_LATEST_HASHES["$repo"]="$latest_hash"
}

latest_action_ref() {
  local repo="$1"
  local ref_type="$2"

  cache_latest_action_version "$repo"
  case "$ref_type" in
  tag)
    printf '%s\n' "${GH_ACTIONS_UPGRADE_LATEST_TAGS[$repo]}"
    ;;
  hash)
    printf '%s\n' "${GH_ACTIONS_UPGRADE_LATEST_HASHES[$repo]}"
    ;;
  *)
    echo "Error: unsupported ref type '$ref_type'" >&2
    exit 1
    ;;
  esac
}

update_workflow_file() {
  local file="$1"
  local tmpfile line prefix value_part comment trimmed_value quote target repo_path repo current_ref desired_ref_type new_ref new_target trailing_comment updated=false updated_count=0

  ensure_tmpdir
  tmpfile=$(mktemp "$GH_ACTIONS_UPGRADE_TMPDIR/file.XXXXXX")

  while IFS= read -r line || [ -n "$line" ]; do
    if [[ "$line" =~ ^([[:space:]-]*uses:[[:space:]]*)([^#]*)([[:space:]]*#.*)?$ ]]; then
      prefix="${BASH_REMATCH[1]}"
      value_part="${BASH_REMATCH[2]}"
      comment="${BASH_REMATCH[3]:-}"
      trimmed_value=$(trim_trailing_whitespace "$value_part")
      quote=''
      target="$trimmed_value"

      case "$trimmed_value" in
      \"*\")
        if [ "${trimmed_value: -1}" = '"' ]; then
          quote='"'
          target=${trimmed_value:1:${#trimmed_value}-2}
        fi
        ;;
      \'*\')
        if [ "${trimmed_value: -1}" = "'" ]; then
          quote="'"
          target=${trimmed_value:1:${#trimmed_value}-2}
        fi
        ;;
      esac

      if [[ "$target" =~ ^([^@]+)@([^[:space:]]+)$ ]]; then
        repo_path="${BASH_REMATCH[1]}"
        current_ref="${BASH_REMATCH[2]}"

        if [[ "$repo_path" =~ ^([^/]+/[^/]+)(/.*)?$ ]]; then
          repo="${BASH_REMATCH[1]}"
          if [[ "$target" != ./* ]] && [[ "$target" != docker://* ]] && [[ "$current_ref" != *\$\{\{* ]]; then
            if [ -n "$forced_ref_type" ]; then
              desired_ref_type="$forced_ref_type"
            elif is_commit_hash_ref "$current_ref"; then
              desired_ref_type='hash'
            else
              desired_ref_type='tag'
            fi

            new_ref=$(latest_action_ref "$repo" "$desired_ref_type")
            if [ "$new_ref" != "$current_ref" ]; then
              new_target="${repo_path}@${new_ref}"
              trailing_comment="$comment"
              printf '%s%s%s%s\n' "$prefix" "$quote" "$new_target" "$quote$trailing_comment" >>"$tmpfile"
              debug_log "Updated '$repo' in '$file' from '$current_ref' to '$new_ref'"
              printf '%s\t%s: %s -> %s\n' "$file" "$repo" "$current_ref" "$new_ref" >>"$GH_ACTIONS_UPGRADE_CHANGES_FILE"
              updated=true
              updated_count=$((updated_count + 1))
              continue
            fi
          fi
        fi
      fi
    fi

    printf '%s\n' "$line" >>"$tmpfile"
  done <"$file"

  if [ "$updated" = 'true' ]; then
    mv "$tmpfile" "$file"
    printf '%s\t%s\n' "$file" "$updated_count"
    return 0
  fi

  rm -f "$tmpfile"
  return 1
}

collect_yaml_files() {
  local dir="$1"
  local file

  shopt -s globstar nullglob
  for file in "$dir"/**/*.yml "$dir"/**/*.yaml; do
    [ -f "$file" ] || continue
    printf '%s\n' "$file"
  done
}

main() {
  local file result updated_file_count=0 updated_ref_count=0 file_updates
  local -a yaml_files=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
    --ref-type)
      if [ "$#" -lt 2 ]; then
        echo 'Error: --ref-type requires a value' >&2
        exit 1
      fi
      forced_ref_type="$2"
      shift 2
      ;;
    --ref-type=*)
      forced_ref_type="${1#--ref-type=}"
      shift
      ;;
    --debug)
      debug_mode=true
      shift
      ;;
    -h | --help | help)
      usage
      exit 0
      ;;
    -v | --version | version)
      print_version
      exit 0
      ;;
    *)
      if [ "$target_dir" != '.github' ]; then
        echo "Error: unexpected argument '$1'" >&2
        usage >&2
        exit 1
      fi
      target_dir="$1"
      shift
      ;;
    esac
  done

  case "$forced_ref_type" in
  '' | tag | hash)
    ;;
  *)
    echo "Error: invalid --ref-type '$forced_ref_type'; expected 'tag' or 'hash'" >&2
    exit 1
    ;;
  esac

  if [ ! -d "$target_dir" ]; then
    echo "Error: directory not found: $target_dir" >&2
    exit 1
  fi

  picotools_require_commands git sort
  ensure_tmpdir
  mapfile -t yaml_files < <(collect_yaml_files "$target_dir")
  if [ "${#yaml_files[@]}" -eq 0 ]; then
    echo "No YAML files found under $target_dir."
    exit 0
  fi

  debug_log "Scanning ${#yaml_files[@]} YAML file(s) under '$target_dir'"
  for file in "${yaml_files[@]}"; do
    if result=$(update_workflow_file "$file"); then
      file_updates=${result#*$'\t'}
      updated_file_count=$((updated_file_count + 1))
      updated_ref_count=$((updated_ref_count + file_updates))
    fi
  done

  if [ "$updated_file_count" -eq 0 ]; then
    echo 'No updates found.'
    exit 0
  fi

  echo "Updated ${updated_ref_count} action reference(s) across ${updated_file_count} file(s)."
  if [ -f "$GH_ACTIONS_UPGRADE_CHANGES_FILE" ] && [ -s "$GH_ACTIONS_UPGRADE_CHANGES_FILE" ]; then
    local current_file='' line change_file change_text
    printf 'Updated actions:\n'
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      change_file=${line%%$'\t'*}
      change_text=${line#*$'\t'}
      if [ "$change_file" != "$current_file" ]; then
        current_file="$change_file"
        printf '  %s\n' "$current_file"
      fi
      printf '    %s\n' "$change_text"
    done <"$GH_ACTIONS_UPGRADE_CHANGES_FILE"
  fi
}

main "$@"
