#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" box commands config debug git prompt table ui version

GIT_PROFILE_LIB_DIR="${SCRIPT_DIR}/../lib/picotools/git-profile"
if [ ! -d "$GIT_PROFILE_LIB_DIR" ]; then
  GIT_PROFILE_LIB_DIR="${SCRIPT_DIR}/../../tools/lib/picotools/git-profile"
fi
for GIT_PROFILE_MODULE in profile resources token; do
  if [ ! -f "$GIT_PROFILE_LIB_DIR/${GIT_PROFILE_MODULE}.sh" ]; then
    echo "Error: missing git-profile module '${GIT_PROFILE_MODULE}.sh'" >&2
    exit 1
  fi
  # shellcheck disable=SC1090
  . "$GIT_PROFILE_LIB_DIR/${GIT_PROFILE_MODULE}.sh"
done
unset GIT_PROFILE_MODULE

usage() {
  cat <<'EOF'
Usage: git-profile [--debug] <command>

Commands:
  create                     Create a saved git profile with optional PAT storage
  update                     Update a saved git profile and its optional PAT
  list                       List saved git profiles and whether a PAT is configured
  read [--commands]          Show detailed information for a saved git profile
  token                      Print the active repository profile's PAT to stdout
  commands                   Print shell commands for saved git profiles
  set                        Apply a saved git profile and record picotools.gitProfile locally
  clone [<profile> <url>]    Clone a repository and record picotools.gitProfile in the clone
  delete                     Delete a saved git profile and its optional PAT

Options:
  --debug                   Print progress details to stderr (global only; place before command)
  -h, --help, help          Show this help message
  -v, --version, version    Show the tool version

Notes:
  create, update, list, commands, delete, set, and token accept no command
  arguments; read accepts only --commands. clone also supports
  clone <profile> --url <url>; no clone arguments starts an interactive flow.
  Saved profile config lives under ${XDG_CONFIG_HOME:-$HOME/.config}/git-profile.
  Saved profile files are tool-owned and reconstructed by create/update;
  unmanaged keys or comments in those files are not preserved.
  Optional PATs live under ${XDG_DATA_HOME:-$HOME/.local/share}/git-profile
  with 0700 directory and 0600 file permissions. PAT reads and status checks
  fail closed when permissions drift; writes repair safe regular-file paths
  and publish with same-directory atomic replacement.
  Profile changes are validated before publish; failed PAT writes roll back
  profile changes, and delete preflights profile/PAT state before key removal.
  New SSH profiles store picotools.sshKeyPath and derive core.sshCommand;
  legacy core.sshCommand parsing is limited to commands emitted by git-profile.
  `token` writes a secret to stdout; use it only in trusted pipelines or
  command substitution.
  Operational commands require git. Generating SSH keys requires ssh-keygen;
  generating or deleting GPG keys requires the configured GPG command.
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

require_no_args() {
  local command_name="$1"
  shift

  if [ "$#" -gt 0 ]; then
    echo "Error: $command_name does not accept arguments: $1" >&2
    usage >&2
    exit 1
  fi
}

debug_mode=false

debug_enabled() {
  [ "$debug_mode" = 'true' ]
}

debug_log() {
  if debug_enabled; then
    picotools_debug_log 'git-profile' "$1"
  fi
}

require_git_command() {
  picotools_require_command git
}

GIT_CONTEXT_TMPFILES=()
GIT_CONTEXT_CLEANUP_TRAP_REGISTERED=false
# Referenced by the git-profile resource module after sourcing.
# shellcheck disable=SC2034
GIT_CONTEXT_GENERATED_SSH_KEY_PATHS=()
# shellcheck disable=SC2034
GIT_CONTEXT_GENERATED_GPG_KEYS=()

cleanup_tmpfiles() {
  if [ "${#GIT_CONTEXT_TMPFILES[@]}" -gt 0 ]; then
    rm -f "${GIT_CONTEXT_TMPFILES[@]}"
  fi
}

cleanup_on_signal() {
  local status="$1"

  cleanup_tmpfiles
  exit "$status"
}

register_cleanup_trap() {
  if [ "$GIT_CONTEXT_CLEANUP_TRAP_REGISTERED" = 'true' ]; then
    return 0
  fi

  trap 'cleanup_tmpfiles' EXIT
  trap 'cleanup_on_signal 129' HUP
  trap 'cleanup_on_signal 130' INT
  trap 'cleanup_on_signal 143' TERM
  GIT_CONTEXT_CLEANUP_TRAP_REGISTERED=true
}

register_tmpfile() {
  register_cleanup_trap
  GIT_CONTEXT_TMPFILES+=("$1")
}

prompt_pat_update_action() {
  local configured="$1"
  local selection
  local -a options=()

  if [ "$configured" = 'yes' ]; then
    options=(
      'Keep PAT [configured]'
      'Replace PAT'
      'Remove PAT'
    )
  else
    options=(
      'Keep PAT [not configured]'
      'Add PAT'
    )
  fi

  if ! selection=$(picotools_prompt_select_index 'PAT' 'Select PAT action' 1 false "${options[@]}"); then
    return 1
  fi

  case "$configured:$selection" in
  yes:1 | no:1)
    printf '%s\n' keep
    ;;
  yes:2)
    printf '%s\n' replace
    ;;
  yes:3)
    printf '%s\n' remove
    ;;
  no:2)
    printf '%s\n' add
    ;;
  *)
    echo 'Error: invalid PAT action selection' >&2
    exit 1
    ;;
  esac
}

prompt_update_field() {
  local allow_gpg_program="$1"
  local allow_ssh_add_on_start="$2"
  local state_name="$3"
  local current_pat_status="$4"
  local -n profile_ref="$state_name"
  local selection
  local option_gpg_program option_ssh_add_on_start
  local -a options=()

  while true; do
    if [ "$allow_gpg_program" = 'yes' ]; then
      option_gpg_program="GPG Program [${profile_ref[gpg_program]}]"
    else
      option_gpg_program='GPG Program [-] (requires GPG signing enabled)'
    fi
    if [ "$allow_ssh_add_on_start" = 'yes' ]; then
      option_ssh_add_on_start="SSH Add On Start [${profile_ref[ssh_add_on_start]}]"
    else
      option_ssh_add_on_start='SSH Add On Start [-] (requires SSH enabled)'
    fi

    options=(
      "$option_gpg_program"
      "Autocrlf [${profile_ref[autocrlf]}]"
      "FileMode [${profile_ref[file_mode]}]"
      "Pull Rebase [${profile_ref[pull_rebase]}]"
      "Rebase AutoStash [${profile_ref[rebase_autostash]}]"
      "Push Default [${profile_ref[push_default]}]"
      "Push AutoSetupRemote [${profile_ref[push_autosetupremote]}]"
      "Core Editor [${profile_ref[core_editor]}]"
      "$option_ssh_add_on_start"
      "PAT [$current_pat_status]"
      'Done'
    )

    if ! selection=$(picotools_prompt_select_index 'Optional settings' 'Select setting' '' false "${options[@]}"); then
      return 1
    fi

    case "$selection" in
    1)
      if [ "$allow_gpg_program" != 'yes' ]; then
        echo 'GPG Program can only be updated when GPG signing is enabled for the profile.' >&2
        continue
      fi
      printf '%s\n' gpg_program
      return 0
      ;;
    2)
      printf '%s\n' autocrlf
      return 0
      ;;
    3)
      printf '%s\n' file_mode
      return 0
      ;;
    4)
      printf '%s\n' pull_rebase
      return 0
      ;;
    5)
      printf '%s\n' rebase_autostash
      return 0
      ;;
    6)
      printf '%s\n' push_default
      return 0
      ;;
    7)
      printf '%s\n' push_autosetupremote
      return 0
      ;;
    8)
      printf '%s\n' core_editor
      return 0
      ;;
    9)
      if [ "$allow_ssh_add_on_start" != 'yes' ]; then
        echo 'SSH Add On Start can only be updated when SSH is enabled for the profile.' >&2
        continue
      fi
      printf '%s\n' ssh_add_on_start
      return 0
      ;;
    10)
      printf '%s\n' pat
      return 0
      ;;
    11)
      printf '%s\n' 'done'
      return 0
      ;;
    esac
  done
}

write_local_value() {
  local key="$1"
  local value="$2"

  unset_local_value "$key"
  git config --local "$key" "$value"
}

unset_local_value() {
  local key="$1"

  git config --local --unset-all "$key" 2>/dev/null || true
}

format_context_summary_row() {
  local file="$1"
  local index="$2"
  local name ssh_enabled gpg_enabled pat_enabled user_name email ssh_key_path

  name=$(context_name_from_file "$file")
  user_name=$(git config -f "$file" --get user.name)
  email=$(git config -f "$file" --get user.email)
  ssh_key_path=$(read_context_ssh_key_path "$file")

  if [ -n "$ssh_key_path" ]; then
    ssh_enabled=yes
  else
    ssh_enabled=no
  fi

  if context_uses_gpg "$file"; then
    gpg_enabled=yes
  else
    gpg_enabled=no
  fi

  if ! pat_enabled=$(context_token_status "$name"); then
    return 1
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$index" \
    "$name" \
    "$user_name" \
    "$email" \
    "$pat_enabled" \
    "$ssh_enabled" \
    "$gpg_enabled"
}

print_context_detail() {
  local file="$1"
  local prompt_public_key="${2:-yes}"
  local name user_name email ssh_command ssh_key_path signing_key gpg_program
  local autocrlf file_mode pull_rebase rebase_autostash push_default
  local push_autosetupremote core_editor commit_gpgsign tag_gpgsign
  local ssh_add_on_start pat_enabled public_key_path show_public_key

  name=$(context_name_from_file "$file")
  user_name=$(read_context_value "$file" user.name)
  email=$(read_context_value "$file" user.email)
  ssh_key_path=$(read_context_ssh_key_path "$file")
  ssh_command=$(read_context_ssh_command "$file")
  signing_key=$(read_context_value_optional "$file" user.signingkey)
  gpg_program=$(read_context_value_optional "$file" gpg.program)
  commit_gpgsign=$(read_managed_context_value "$file" commit.gpgsign)
  tag_gpgsign=$(read_managed_context_value "$file" tag.gpgsign)
  autocrlf=$(read_managed_context_value "$file" core.autocrlf)
  file_mode=$(read_managed_context_value "$file" core.fileMode)
  pull_rebase=$(read_managed_context_value "$file" pull.rebase)
  rebase_autostash=$(read_managed_context_value "$file" rebase.autoStash)
  push_default=$(read_managed_context_value "$file" push.default)
  push_autosetupremote=$(read_managed_context_value "$file" push.autoSetupRemote)
  core_editor=$(read_managed_context_value "$file" core.editor)
  ssh_add_on_start=$(read_managed_context_value "$file" picotools.sshAddOnStart)
  if ! pat_enabled=$(context_token_status "$name"); then
    exit 1
  fi

  picotools_print_two_column_table \
    $'Name	'"$name" \
    $'User	'"$user_name" \
    $'Email	'"$email" \
    $'PAT	'"$pat_enabled" \
    $'SSH	'"$([ -n "$ssh_command" ] && printf yes || printf no)" \
    $'SSH Key	'"$(picotools_display_value_or_dash "$ssh_key_path")" \
    $'SSH Command	'"$(picotools_display_value_or_dash "$ssh_command")" \
    $'SSH Add On Start	'"$ssh_add_on_start" \
    $'GPG	'"$([ "$commit_gpgsign" = 'true' ] && printf yes || printf no)" \
    $'Signing Key	'"$(picotools_display_value_or_dash "$signing_key")" \
    $'Commit GPG Sign	'"$commit_gpgsign" \
    $'Tag GPG Sign	'"$tag_gpgsign" \
    $'GPG Program	'"$(picotools_display_value_or_dash "$gpg_program")" \
    $'Autocrlf	'"$autocrlf" \
    $'FileMode	'"$file_mode" \
    $'Pull Rebase	'"$pull_rebase" \
    $'Rebase AutoStash	'"$rebase_autostash" \
    $'Push Default	'"$push_default" \
    $'Push AutoSetupRemote	'"$push_autosetupremote" \
    $'Core Editor	'"$core_editor"

  public_key_path=$(public_ssh_key_path "$ssh_key_path")

  if [ "$prompt_public_key" = 'yes' ] && [ -n "$public_key_path" ]; then
    show_public_key=$(picotools_prompt_yes_no 'Display public SSH key?' no)
    if [ "$show_public_key" = 'yes' ]; then
      print_public_ssh_key "$public_key_path"
    fi
  fi
}

context_ssh_add_key_path() {
  local file="$1"
  local ssh_add_on_start ssh_key_path

  ssh_add_on_start=$(read_managed_context_value "$file" picotools.sshAddOnStart)
  if [ "$ssh_add_on_start" != 'true' ]; then
    return 0
  fi

  ssh_key_path=$(read_context_ssh_key_path "$file")
  printf '%s\n' "$ssh_key_path"
}

print_context_commands() {
  local file="$1"
  local ssh_key_path

  ssh_key_path=$(context_ssh_add_key_path "$file")
  if [ -z "$ssh_key_path" ]; then
    return 0
  fi

  print_ssh_agent_start_commands
  print_ssh_add_commands "$ssh_key_path"
}

save_context_and_token() {
  local file="$1"
  local name="$2"
  local token_action="$3"
  local pat_token="$4"
  local state_name="$5"
  local backup='' existed=no

  if ! preflight_context_token_state "$name" "$token_action" "$pat_token"; then
    return 1
  fi

  if ! snapshot_context_file_state "$file" backup existed; then
    return 1
  fi

  if ! save_context "$file" "$state_name"; then
    restore_context_file_state "$file" "$backup" "$existed"
    return 1
  fi

  case "$token_action" in
  write)
    if ! write_context_token "$name" "$pat_token"; then
      restore_context_file_state "$file" "$backup" "$existed"
      return 1
    fi
    ;;
  delete)
    if ! delete_context_token "$name"; then
      restore_context_file_state "$file" "$backup" "$existed"
      return 1
    fi
    ;;
  keep)
    ;;
  *)
    echo "Error: invalid token transaction action '$token_action'" >&2
    restore_context_file_state "$file" "$backup" "$existed"
    return 1
    ;;
  esac
}

create_context() {
  local name file overwrite pat_token=''
  local resolve_tmp
  local -A profile=()

  require_git_command
  git_profile_state_defaults profile

  picotools_ui_section 'Create Git Profile'
  picotools_ui_step 1 3 'Choose profile identity'
  name=$(picotools_prompt_value 'Context name')
  validate_context_name "$name"
  file=$(context_file "$name")
  ensure_context_dir
  debug_log "Creating profile '$name' at '$file'"

  if [ -f "$file" ]; then
    overwrite=$(picotools_prompt_yes_no "Context '$name' already exists. Overwrite?" no)
    if [ "$overwrite" != 'yes' ]; then
      picotools_cancel
      exit 1
    fi
  fi

  profile[user_name]=$(picotools_prompt_value 'Git user name')
  profile[email]=$(picotools_prompt_value 'Git email')
  picotools_ui_step 2 3 'Configure SSH, signing, and PAT'
  profile[use_ssh]=$(picotools_prompt_yes_no 'Use SSH connection?' no)

  if [ "${profile[use_ssh]}" = 'yes' ]; then
    if ! resolve_tmp=$(mktemp); then
      exit 1
    fi
    if ! resolve_ssh_key_path "${profile[email]}" "$name" >"$resolve_tmp"; then
      rm -f "$resolve_tmp"
      exit 1
    fi
    profile[ssh_key_path]=$(<"$resolve_tmp")
    rm -f "$resolve_tmp"
    if [ "$(picotools_prompt_yes_no 'Add SSH key to agent on shell start?' no)" = 'yes' ]; then
      profile[ssh_add_on_start]=true
    else
      profile[ssh_add_on_start]=false
    fi
  else
    profile[ssh_add_on_start]=false
  fi

  profile[use_gpg]=$(picotools_prompt_yes_no 'Use GPG signing?' no)

  if [ "${profile[use_gpg]}" = 'yes' ]; then
    if ! resolve_tmp=$(mktemp); then
      exit 1
    fi
    if ! resolve_signing_key '' "${profile[user_name]}" "${profile[email]}" >"$resolve_tmp"; then
      rm -f "$resolve_tmp"
      exit 1
    fi
    profile[signing_key]=$(<"$resolve_tmp")
    rm -f "$resolve_tmp"
    profile[gpg_program]=$(default_gpg_program)
  fi

  pat_token=$(picotools_prompt_secret_value 'GitHub PAT (optional; leave blank for none)')

  picotools_ui_step 3 3 'Save profile settings'
  picotools_ui_summary 'Review Git Profile' \
    "Profile: ${name}" \
    "User: ${profile[user_name]}" \
    "Email: ${profile[email]}" \
    "PAT: $([ -n "$pat_token" ] && printf yes || printf no)" \
    "SSH: ${profile[use_ssh]}" \
    "GPG: ${profile[use_gpg]}"

  if [ -n "$pat_token" ]; then
    if ! save_context_and_token "$file" "$name" write "$pat_token" profile; then
      rollback_generated_create_material
      exit 1
    fi
  else
    if ! save_context_and_token "$file" "$name" delete '' profile; then
      rollback_generated_create_material
      exit 1
    fi
  fi

  picotools_ui_summary 'Git Profile Saved' \
    "Profile: ${name}" \
    "User: ${profile[user_name]}" \
    "Email: ${profile[email]}" \
    "PAT: $([ -n "$pat_token" ] && printf yes || printf no)" \
    "SSH: ${profile[use_ssh]}" \
    "GPG: ${profile[use_gpg]}"

  echo "Saved profile '$name'."
}

list_contexts() {
  local file row
  local index=1
  local -a rows=()

  require_git_command

  if ! saved_context_files >/dev/null; then
    echo 'No git profiles found.'
    return 0
  fi

  while IFS= read -r file; do
    if ! row=$(format_context_summary_row "$file" "$index"); then
      return 1
    fi
    rows+=("$row")
    index=$((index + 1))
  done < <(saved_context_files)

  debug_log "Listing ${#rows[@]} saved profile(s)"
  picotools_print_table $'#\tName\tUser\tEmail\tPAT\tSSH\tGPG' "${rows[@]}"
}

read_context() {
  local commands_only=no
  local file

  while [ "$#" -gt 0 ]; do
    case "$1" in
    --commands)
      commands_only=yes
      ;;
    *)
      echo "Error: unknown read option '$1'" >&2
      exit 1
      ;;
    esac
    shift
  done

  require_git_command

  if ! file=$(select_context_file); then
    return 1
  fi
  debug_log "Reading profile from '$file'"
  if [ "$commands_only" = 'yes' ]; then
    print_context_commands "$file"
  else
    print_context_detail "$file"
  fi
}

print_saved_context_commands() {
  local file ssh_key_path printed_header=no

  require_git_command

  if ! saved_context_files >/dev/null; then
    return 0
  fi

  while IFS= read -r file; do
    ssh_key_path=$(context_ssh_add_key_path "$file")
    if [ -z "$ssh_key_path" ]; then
      continue
    fi

    if [ "$printed_header" = 'no' ]; then
      print_ssh_agent_start_commands
      printed_header=yes
    fi

    print_ssh_add_commands "$ssh_key_path"
  done < <(saved_context_files)
}

print_context_public_key() {
  local file="$1"
  local ssh_key_path public_key_path

  ssh_key_path=$(read_context_ssh_key_path "$file")
  public_key_path=$(public_ssh_key_path "$ssh_key_path")

  if [ -z "$public_key_path" ]; then
    echo 'No public SSH key found.' >&2
    return 0
  fi

  print_public_ssh_key "$public_key_path"
}

select_context_file() {
  local file name selection status
  local files=()
  local names=()

  while IFS= read -r file; do
    files+=("$file")
    name=$(context_name_from_file "$file")
    names+=("$name")
  done < <(saved_context_files || true)

  if [ "${#files[@]}" -eq 0 ]; then
    echo 'No git profiles found.' >&2
    return 1
  fi

  if selection=$(picotools_prompt_select_index 'Profiles' 'Select profile' '' false "${names[@]}"); then
    printf '%s\n' "${files[$((selection - 1))]}"
    return 0
  else
    status=$?
  fi

  if [ "$status" -eq 2 ]; then
    picotools_cancel
  fi
  return 1
}

delete_context_file() {
  local file="$1"
  local confirm delete_ssh delete_gpg ssh_key_path signing_key gpg_program
  local name pat_configured
  local cleanup_status=0

  name=$(context_name_from_file "$file")
  if ! preflight_delete_context_profile "$file" "$name"; then
    exit 1
  fi

  confirm=$(picotools_prompt_yes_no "Delete '$name'?" no)
  if [ "$confirm" != 'yes' ]; then
    echo 'Cancelled.' >&2
    exit 1
  fi

  signing_key=$(read_context_value_optional "$file" user.signingkey)
  gpg_program=$(read_context_value_optional "$file" gpg.program)
  if [ -z "$gpg_program" ]; then
    gpg_program=$(default_gpg_program)
  fi

  if [ -n "$signing_key" ]; then
    delete_gpg=$(picotools_prompt_yes_no "Delete GPG signing key '$signing_key'?" no)
  fi

  ssh_key_path=$(read_context_ssh_key_path "$file")
  if [ -n "$ssh_key_path" ]; then
    delete_ssh=$(picotools_prompt_yes_no "Delete SSH key files '$ssh_key_path' and '$ssh_key_path.pub'?" no)
  fi

  if ! pat_configured=$(context_token_status "$name" delete); then
    exit 1
  fi
  if [ "${delete_gpg:-no}" = 'yes' ] && ! validate_gpg_signing_key_for_delete "$signing_key"; then
    exit 1
  fi
  if [ "${delete_gpg:-no}" = 'yes' ]; then
    picotools_require_command "$gpg_program"
  fi

  picotools_ui_summary 'Review Profile Deletion' \
    "Profile: ${name}" \
    "Delete PAT: ${pat_configured}" \
    "Delete SSH material: ${delete_ssh:-no}" \
    "Delete GPG material: ${delete_gpg:-no}"

  if ! delete_context_token "$name"; then
    exit 1
  fi
  debug_log "Deleting profile file '$file'"
  rm -f -- "$file"

  if [ "${delete_ssh:-no}" = 'yes' ] && ! delete_ssh_key_files "$ssh_key_path"; then
    echo "Error: deleted profile '$name', but failed to delete SSH key files '$ssh_key_path' and '$ssh_key_path.pub'" >&2
    cleanup_status=1
  fi
  if [ "${delete_gpg:-no}" = 'yes' ] && ! delete_gpg_key "$signing_key" "$gpg_program"; then
    echo "Error: deleted profile '$name', but failed to delete GPG signing key '$signing_key'" >&2
    cleanup_status=1
  fi
  if [ "$cleanup_status" -ne 0 ]; then
    exit 1
  fi

  picotools_ui_status ok "Deleted profile '$name'"
  echo 'Deleted profile.'
}

delete_context() {
  local file

  require_git_command
  if ! file=$(select_context_file); then
    return 1
  fi
  delete_context_file "$file"
}

ensure_git_repository() {
  local command_name="${1:-set}"

  require_git_command
  if [ "$(git rev-parse --is-inside-work-tree 2>/dev/null || true)" != 'true' ]; then
    echo "Error: $command_name must be run inside a Git repository" >&2
    exit 1
  fi
}

apply_context() {
  local file="$1"
  local name user_name email signing_key signing_key_present gpg_program gpg_program_present
  local ssh_command ssh_command_present ssh_add_on_start commit_gpgsign tag_gpgsign
  local autocrlf file_mode pull_rebase rebase_autostash push_default push_autosetupremote
  local core_editor
  local -A profile=()

  name=$(context_name_from_file "$file")
  debug_log "Applying profile values from '$file'"

  validate_profile_file_schema "$file" || return 1

  read_profile_required_value "$file" user.name user_name || return 1
  read_profile_required_value "$file" user.email email || return 1
  ssh_command=$(read_context_ssh_command "$file")
  if [ -n "$ssh_command" ]; then
    ssh_command_present=yes
  else
    ssh_command_present=no
  fi
  read_context_value_presence "$file" user.signingkey signing_key signing_key_present || return 1
  read_context_value_presence "$file" gpg.program gpg_program gpg_program_present || return 1
  read_profile_default_value "$file" commit.gpgsign false commit_gpgsign || return 1
  read_profile_default_value "$file" tag.gpgsign false tag_gpgsign || return 1
  read_profile_default_value "$file" core.autocrlf false autocrlf || return 1
  read_profile_default_value "$file" core.fileMode true file_mode || return 1
  read_profile_default_value "$file" pull.rebase "$(default_pull_rebase)" pull_rebase || return 1
  read_profile_default_value "$file" rebase.autoStash "$(default_rebase_autostash)" rebase_autostash || return 1
  read_profile_default_value "$file" push.default "$(default_push_default)" push_default || return 1
  read_profile_default_value "$file" push.autoSetupRemote "$(default_push_autosetupremote)" push_autosetupremote || return 1
  read_profile_default_value "$file" core.editor "$(default_core_editor)" core_editor || return 1
  read_profile_default_value "$file" picotools.sshAddOnStart "$(default_ssh_add_on_start)" ssh_add_on_start || return 1

  if [ "$ssh_command_present" = 'yes' ]; then
    validate_nonblank_profile_value "profile '$name'" core.sshCommand "$ssh_command" || return 1
  fi
  if [ "$signing_key_present" = 'yes' ]; then
    validate_nonblank_profile_value "profile '$name'" user.signingkey "$signing_key" || return 1
  fi
  if [ "$gpg_program_present" = 'yes' ]; then
    validate_nonblank_profile_value "profile '$name'" gpg.program "$gpg_program" || return 1
  fi
  git_profile_state_defaults profile
  profile[user_name]="$user_name"
  profile[email]="$email"
  profile[autocrlf]="$autocrlf"
  profile[file_mode]="$file_mode"
  profile[pull_rebase]="$pull_rebase"
  profile[rebase_autostash]="$rebase_autostash"
  profile[push_default]="$push_default"
  profile[push_autosetupremote]="$push_autosetupremote"
  profile[core_editor]="$core_editor"
  profile[ssh_add_on_start]="$ssh_add_on_start"
  git_profile_state_validate_managed_values "profile '$name'" profile "$commit_gpgsign" "$tag_gpgsign" || return 1

  write_local_value user.name "$user_name"
  write_local_value user.email "$email"
  write_local_value commit.gpgsign "$commit_gpgsign"
  write_local_value tag.gpgsign "$tag_gpgsign"
  write_local_value core.autocrlf "$autocrlf"
  write_local_value core.fileMode "$file_mode"
  write_local_value pull.rebase "$pull_rebase"
  write_local_value rebase.autoStash "$rebase_autostash"
  write_local_value push.default "$push_default"
  write_local_value push.autoSetupRemote "$push_autosetupremote"
  write_local_value core.editor "$core_editor"
  write_local_value picotools.sshAddOnStart "$ssh_add_on_start"
  write_local_value picotools.gitProfile "$name"

  if [ "$ssh_command_present" = 'yes' ]; then
    write_local_value core.sshCommand "$ssh_command"
  else
    unset_local_value core.sshCommand
  fi

  if [ "$signing_key_present" = 'yes' ]; then
    write_local_value user.signingkey "$signing_key"
  else
    unset_local_value user.signingkey
  fi

  if [ "$gpg_program_present" = 'yes' ]; then
    write_local_value gpg.program "$gpg_program"
  else
    unset_local_value gpg.program
  fi
}

set_context() {
  local file

  ensure_git_repository
  if ! file=$(select_context_file); then
    return 1
  fi
  set_context_file "$file"
}

set_context_file() {
  local file="$1"

  ensure_git_repository
  debug_log "Applying selected profile '$file' to current repository"
  apply_context "$file"
  echo "Applied profile '$(context_name_from_file "$file")'."
}

update_context_file() {
  local file="$1"
  local name commit_gpgsign token_configured token_action=keep selected_token_action pat_token=''
  local selected_field
  local -A profile=()

  git_profile_state_defaults profile

  name=$(context_name_from_file "$file")
  picotools_ui_section 'Update Git Profile'
  picotools_ui_step 1 2 'Select fields to update'
  debug_log "Updating profile '$name' from '$file'"
  profile[user_name]=$(read_context_value "$file" user.name)
  profile[email]=$(read_context_value "$file" user.email)

  profile[ssh_key_path]=$(read_context_ssh_key_path "$file")
  if [ -n "${profile[ssh_key_path]}" ]; then
    profile[use_ssh]=yes
  else
    profile[use_ssh]=no
  fi

  commit_gpgsign=$(read_managed_context_value "$file" commit.gpgsign)
  if [ "$commit_gpgsign" = 'true' ]; then
    profile[use_gpg]=yes
  else
    profile[use_gpg]=no
  fi

  profile[signing_key]=$(read_context_value_optional "$file" user.signingkey)
  profile[gpg_program]=$(read_context_value_optional "$file" gpg.program)
  profile[autocrlf]=$(read_managed_context_value "$file" core.autocrlf)
  profile[file_mode]=$(read_managed_context_value "$file" core.fileMode)
  profile[pull_rebase]=$(read_managed_context_value "$file" pull.rebase)
  profile[rebase_autostash]=$(read_managed_context_value "$file" rebase.autoStash)
  profile[push_default]=$(read_managed_context_value "$file" push.default)
  profile[push_autosetupremote]=$(read_managed_context_value "$file" push.autoSetupRemote)
  profile[core_editor]=$(read_managed_context_value "$file" core.editor)
  profile[ssh_add_on_start]=$(read_managed_context_value "$file" picotools.sshAddOnStart)
  if ! token_configured=$(context_token_status "$name"); then
    exit 1
  fi

  while true; do
    if ! selected_field=$(prompt_update_field "${profile[use_gpg]}" "${profile[use_ssh]}" profile "$token_configured"); then
      picotools_cancel
      exit 1
    fi

    case "$selected_field" in
    gpg_program)
      profile[gpg_program]=$(picotools_prompt_value 'gpg.program' "${profile[gpg_program]}")
      if [ -z "${profile[gpg_program]}" ]; then
        profile[gpg_program]=$(default_gpg_program)
      fi
      ;;
    autocrlf)
      profile[autocrlf]=$(picotools_prompt_value 'core.autocrlf' "${profile[autocrlf]}")
      ;;
    file_mode)
      profile[file_mode]=$(picotools_prompt_value 'core.fileMode' "${profile[file_mode]}")
      ;;
    pull_rebase)
      profile[pull_rebase]=$(picotools_prompt_value 'pull.rebase' "${profile[pull_rebase]}")
      ;;
    rebase_autostash)
      profile[rebase_autostash]=$(picotools_prompt_value 'rebase.autoStash' "${profile[rebase_autostash]}")
      ;;
    push_default)
      profile[push_default]=$(picotools_prompt_value 'push.default' "${profile[push_default]}")
      ;;
    push_autosetupremote)
      profile[push_autosetupremote]=$(picotools_prompt_value 'push.autoSetupRemote' "${profile[push_autosetupremote]}")
      ;;
    core_editor)
      profile[core_editor]=$(picotools_prompt_value 'core.editor' "${profile[core_editor]}")
      ;;
    ssh_add_on_start)
      profile[ssh_add_on_start]=$(picotools_prompt_value 'picotools.sshAddOnStart' "${profile[ssh_add_on_start]}")
      ;;
    pat)
      if ! selected_token_action=$(prompt_pat_update_action "$token_configured"); then
        picotools_cancel
        exit 1
      fi
      case "$selected_token_action" in
      add | replace)
        pat_token=$(picotools_prompt_secret_value 'GitHub PAT' '' true)
        token_action="$selected_token_action"
        token_configured=yes
        ;;
      remove)
        pat_token=''
        token_action=remove
        token_configured=no
        ;;
      keep)
        ;;
      esac
      ;;
    done)
      break
      ;;
    esac
  done

  if [ "${profile[use_gpg]}" = 'yes' ] && [ -z "${profile[gpg_program]}" ]; then
    profile[gpg_program]=$(default_gpg_program)
  fi

  picotools_ui_summary 'Review Updated Profile' \
    "Profile: ${name}" \
    "User: ${profile[user_name]}" \
    "Email: ${profile[email]}" \
    "PAT: ${token_configured}" \
    "SSH: ${profile[use_ssh]}" \
    "GPG: ${profile[use_gpg]}"

  case "$token_action" in
  add | replace)
    if ! save_context_and_token "$file" "$name" write "$pat_token" profile; then
      exit 1
    fi
    ;;
  remove)
    if ! save_context_and_token "$file" "$name" delete '' profile; then
      exit 1
    fi
    ;;
  keep)
    if ! save_context_and_token "$file" "$name" keep '' profile; then
      exit 1
    fi
    ;;
  esac
  picotools_ui_step 2 2 'Save updated settings'
  picotools_ui_summary 'Git Profile Updated' \
    "Profile: ${name}" \
    "User: ${profile[user_name]}" \
    "Email: ${profile[email]}" \
    "PAT: ${token_configured}" \
    "SSH: ${profile[use_ssh]}" \
    "GPG: ${profile[use_gpg]}"
  echo "Updated profile '$name'."
}

update_context() {
  local file

  require_git_command
  if ! file=$(select_context_file); then
    return 1
  fi
  update_context_file "$file"
}

clone_profile_interactive() {
  local file url ssh_command ssh_key_path

  require_git_command
  if ! file=$(select_context_file); then
    return 1
  fi

  url=$(picotools_prompt_value 'Git URL')
  if [ -z "$url" ]; then
    echo 'Error: git URL is required' >&2
    exit 1
  fi

  clone_with_profile "$file" "$url"
}

clone_profile_cli() {
  local profile_name='' url='' file

  while [ "$#" -gt 0 ]; do
    if [ -n "$profile_name" ] && [ -z "$url" ]; then
      if [ "$1" = '--debug' ]; then
        echo 'Error: --debug is a global option; place it before the command' >&2
        usage >&2
        exit 1
      fi
      url="$1"
      shift
      continue
    fi

    case "$1" in
    --debug)
      echo 'Error: --debug is a global option; place it before the command' >&2
      usage >&2
      exit 1
      ;;
    --url)
      if [ "$#" -lt 2 ]; then
        echo 'Error: --url requires a value' >&2
        exit 1
      fi
      url="$2"
      shift 2
      ;;
    -*)
      echo "Error: unknown clone option '$1'" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [ -z "$profile_name" ]; then
        profile_name="$1"
        shift
      else
        echo "Error: unknown clone option '$1'" >&2
        usage >&2
        exit 1
      fi
      ;;
    esac
  done

  if [ -z "$profile_name" ]; then
    echo 'Error: clone requires a profile name' >&2
    exit 1
  fi

  if [ -z "$url" ]; then
    url=$(picotools_prompt_value 'Git URL')
    if [ -z "$url" ]; then
      echo 'Error: git URL is required' >&2
      exit 1
    fi
  fi

  require_git_command
  file=$(require_existing_profile_file "$profile_name")
  clone_with_profile "$file" "$url"
}

clone_with_profile() {
  local file="$1"
  local url="$2"
  local name ssh_command ssh_key_path
  local -a clone_args=()

  name=$(context_name_from_file "$file")
  ssh_key_path=$(read_context_ssh_key_path "$file")
  ssh_command=$(read_context_ssh_command "$file")

  debug_log "Cloning '$url' with profile '$name'"
  clone_args=(--config "picotools.gitProfile=$name")

  if [ -n "$ssh_command" ]; then
    if [ -n "$ssh_key_path" ]; then
      debug_log "Using SSH key: $ssh_key_path"
    else
      debug_log 'Using profile SSH command for clone'
    fi
    GIT_SSH_COMMAND="$ssh_command" git clone "${clone_args[@]}" -- "$url"
  else
    git clone "${clone_args[@]}" -- "$url"
  fi

  echo "Cloned '$url' using profile '$name'."
}

clone_profile() {
  if [ "$#" -eq 0 ]; then
    clone_profile_interactive
    return $?
  fi

  clone_profile_cli "$@"
}

print_repository_token() {
  local name file

  ensure_git_repository token
  name=$(git config --local --get picotools.gitProfile 2>/dev/null || true)
  if [ -z "$name" ]; then
    echo 'Error: no git profile is recorded in this repository' >&2
    exit 1
  fi

  validate_context_name "$name"
  file=$(context_file "$name")
  if [ ! -f "$file" ]; then
    echo "Error: repository git profile '$name' does not exist" >&2
    exit 1
  fi

  debug_log "Reading PAT for repository profile '$name'"
  read_context_token "$name"
}

main() {
  while [ "${1:-}" = '--debug' ]; do
    debug_mode=true
    shift
  done

  case "${1:-}" in
  -h | --help | help | "")
    usage
    exit 0
    ;;
  -v | --version | version)
    print_version
    exit 0
    ;;
  create)
    shift
    require_no_args create "$@"
    create_context "$@"
    ;;
  list)
    shift
    require_no_args list "$@"
    list_contexts "$@"
    ;;
  read)
    shift
    read_context "$@"
    ;;
  token)
    shift
    require_no_args token "$@"
    print_repository_token "$@"
    ;;
  commands)
    shift
    require_no_args commands "$@"
    print_saved_context_commands "$@"
    ;;
  delete)
    shift
    require_no_args delete "$@"
    delete_context "$@"
    ;;
  set)
    shift
    require_no_args set "$@"
    set_context "$@"
    ;;
  clone)
    shift
    clone_profile "$@"
    ;;
  update)
    shift
    require_no_args update "$@"
    update_context "$@"
    ;;
  *)
    echo "Error: unknown command '$1'" >&2
    usage >&2
    exit 1
    ;;
  esac
}

main "$@"
