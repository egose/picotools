#!/usr/bin/env bash
# shellcheck disable=SC2034 # Nameref output parameters are assigned for callers.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOAD_SH="${SCRIPT_DIR}/../lib/picotools/load.sh"
if [ ! -f "$LOAD_SH" ]; then
  LOAD_SH="${SCRIPT_DIR}/../../lib/picotools/load.sh"
fi
# shellcheck source=../../lib/picotools/load.sh
# shellcheck disable=SC1091
. "$LOAD_SH"
picotools_source_modules "$SCRIPT_DIR" commands git prompt version

usage() {
  cat <<'EOF'
Usage: git-clean-branches [--yes] [--debug] [--] [remote]

Deletes local branches with force semantics and deletes merged remote branches.

The tool first runs 'git fetch --prune <remote>', so remote-tracking refs for the
selected remote may be updated or removed before the deletion plan is shown.
Remote branch candidates must be merged into the freshly resolved remote default
branch. Local branch candidates do not need to be merged. The default branch,
its reviewed OID, current branch, and local branches checked out by any linked
worktree are protected.

After the plan is reviewed, local branches are deleted through an expected-OID
compare-and-swap transaction. Remote branches are preflighted against current
remote OIDs and deleted with explicit leases in one atomic push. Local and remote
deletions are separate phases: a later remote failure does not roll back earlier
local deletions, and the command prints a per-outcome summary. A remote default
movement after the final default-OID check but before the atomic push remains a
server-side race the client cannot combine with candidate deletion leases.

Options:
  --yes       Skip the confirmation prompt after printing the reviewed plan
  --debug     Print progress details to stderr
  --          End option parsing; the following token is the remote name
  -h, --help, help        Show this help message
  -v, --version, version  Show the tool version

Arguments:
  remote      Optional remote name to clean (default: origin). Options may appear
              before or after this argument until -- is used.
EOF
}

print_version() {
  picotools_print_version "$SCRIPT_DIR"
}

debug_mode=false

debug_enabled() {
  [ "$debug_mode" = 'true' ]
}

debug_log() {
  if debug_enabled; then
    printf '[git-clean-branches] %s\n' "$1" >&2
  fi
}

resolve_remote_default_branch() {
  local remote="$1"
  local output
  local line
  local default_branch=

  if ! output=$(git ls-remote --symref -- "$remote" HEAD 2>/dev/null); then
    return 1
  fi

  while IFS= read -r line; do
    case "$line" in
    ref:\ refs/heads/*$'\t'HEAD)
      default_branch=${line#ref: refs/heads/}
      default_branch=${default_branch%$'\t'HEAD}
      ;;
    esac
  done <<<"$output"

  if [ -z "$default_branch" ]; then
    if git ls-remote --exit-code --heads -- "$remote" main >/dev/null 2>&1; then
      default_branch=main
    else
      return 1
    fi
  fi

  printf '%s\n' "$default_branch"
}

validate_remote_default_branch() {
  local remote="$1"
  local default_branch="$2"
  local default_ref="refs/remotes/${remote}/${default_branch}"

  git rev-parse --verify --quiet "${default_ref}^{commit}" >/dev/null || return 1
}

local_branch_name() {
  local ref="$1"

  printf '%s\n' "${ref#refs/heads/}"
}

remote_tracking_branch_name() {
  local remote="$1"
  local ref="$2"
  local prefix="refs/remotes/${remote}/"

  printf '%s\n' "${ref#"$prefix"}"
}

ref_oid() {
  local ref="$1"

  git rev-parse --verify --quiet "${ref}^{object}"
}

contains_branch() {
  local branch="$1"
  shift

  local candidate
  for candidate in "$@"; do
    if [ "$branch" = "$candidate" ]; then
      return 0
    fi
  done

  return 1
}

parse_git_clean_branches_args() {
  local remote_var="$1"
  local assume_yes_var="$2"
  local action_var="$3"
  shift 3

  local -n _gcb_parsed_remote="$remote_var"
  local -n _gcb_parsed_assume_yes="$assume_yes_var"
  local -n _gcb_parsed_action="$action_var"
  local remote_set=false
  local end_of_options=false
  local arg

  _gcb_parsed_remote=origin
  _gcb_parsed_assume_yes=false
  _gcb_parsed_action=run

  for arg in "$@"; do
    if [ "$end_of_options" != true ]; then
      case "$arg" in
      --yes)
        _gcb_parsed_assume_yes=true
        continue
        ;;
      --debug)
        debug_mode=true
        continue
        ;;
      --)
        end_of_options=true
        continue
        ;;
      -h | --help | help)
        _gcb_parsed_action=help
        return 0
        ;;
      -v | --version | version)
        _gcb_parsed_action=version
        return 0
        ;;
      -*)
        echo "Error: unknown option: $arg" >&2
        usage >&2
        return 1
        ;;
      esac
    fi

    if [ "$remote_set" = true ]; then
      echo "Error: unexpected argument: $arg" >&2
      usage >&2
      return 1
    fi
    _gcb_parsed_remote="$arg"
    remote_set=true
  done
}

parse_worktree_branches() {
  local worktree_output="$1"
  local branches_var="$2"
  local -n _gcb_parsed_worktree_branches="$branches_var"
  local line

  _gcb_parsed_worktree_branches=()
  while IFS= read -r line; do
    case "$line" in
    branch\ refs/heads/*)
      _gcb_parsed_worktree_branches+=("${line#branch refs/heads/}")
      ;;
    esac
  done <<<"$worktree_output"
}

fail_stale_plan() {
  local reason="$1"

  printf 'Error: stale branch deletion plan: %s\n' "$reason" >&2
  return 1
}

should_inject_failure() {
  local point="$1"

  [ "${GIT_CLEAN_BRANCHES_FAIL_ON:-}" = "$point" ]
}

mark_all_outcomes() {
  local status="$1"
  local local_branch_names_var="$2"
  local remote_branch_names_var="$3"
  local local_branch_outcomes_var="$4"
  local remote_branch_outcomes_var="$5"
  local -n _gcb_outcome_local_branch_names="$local_branch_names_var"
  local -n _gcb_outcome_remote_branch_names="$remote_branch_names_var"
  local -n _gcb_outcome_local_branch_outcomes="$local_branch_outcomes_var"
  local -n _gcb_outcome_remote_branch_outcomes="$remote_branch_outcomes_var"
  local i

  for i in "${!_gcb_outcome_local_branch_names[@]}"; do
    _gcb_outcome_local_branch_outcomes[i]="$status"
  done
  for i in "${!_gcb_outcome_remote_branch_names[@]}"; do
    _gcb_outcome_remote_branch_outcomes[i]="$status"
  done
}

init_operation_outcomes() {
  mark_all_outcomes 'not-attempted' "$@"
}

summary_status_label() {
  local status="$1"

  case "$status" in
  stale) printf 'stale/skipped' ;;
  not-attempted) printf 'not attempted' ;;
  *) printf '%s' "$status" ;;
  esac
}

print_summary_status() {
  local status="$1"
  local remote="$2"
  local local_branch_names_var="$3"
  local remote_branch_names_var="$4"
  local local_branch_outcomes_var="$5"
  local remote_branch_outcomes_var="$6"
  local -n _gcb_summary_local_branch_names="$local_branch_names_var"
  local -n _gcb_summary_remote_branch_names="$remote_branch_names_var"
  local -n _gcb_summary_local_branch_outcomes="$local_branch_outcomes_var"
  local -n _gcb_summary_remote_branch_outcomes="$remote_branch_outcomes_var"
  local label
  local count=0
  local printed=0
  local limit=20
  local i

  label=$(summary_status_label "$status")

  for i in "${!_gcb_summary_local_branch_names[@]}"; do
    [ "${_gcb_summary_local_branch_outcomes[$i]}" = "$status" ] && count=$((count + 1))
  done
  for i in "${!_gcb_summary_remote_branch_names[@]}"; do
    [ "${_gcb_summary_remote_branch_outcomes[$i]}" = "$status" ] && count=$((count + 1))
  done

  printf '  %s (%s)\n' "$label" "$count"
  [ "$count" -eq 0 ] && return 0

  for i in "${!_gcb_summary_local_branch_names[@]}"; do
    [ "${_gcb_summary_local_branch_outcomes[$i]}" = "$status" ] || continue
    if [ "$printed" -lt "$limit" ]; then
      printf '    local %s\n' "${_gcb_summary_local_branch_names[$i]}"
    fi
    printed=$((printed + 1))
  done
  for i in "${!_gcb_summary_remote_branch_names[@]}"; do
    [ "${_gcb_summary_remote_branch_outcomes[$i]}" = "$status" ] || continue
    if [ "$printed" -lt "$limit" ]; then
      printf '    remote %s/%s\n' "$remote" "${_gcb_summary_remote_branch_names[$i]}"
    fi
    printed=$((printed + 1))
  done

  if [ "$printed" -gt "$limit" ]; then
    printf '    ... %s more\n' "$((printed - limit))"
  fi
}

print_cleanup_summary() {
  local remote="$1"
  local local_branch_names_var="$2"
  local remote_branch_names_var="$3"
  local local_branch_outcomes_var="$4"
  local remote_branch_outcomes_var="$5"

  printf 'Cleanup summary:\n'
  print_summary_status 'succeeded' "$remote" "$local_branch_names_var" "$remote_branch_names_var" "$local_branch_outcomes_var" "$remote_branch_outcomes_var"
  print_summary_status 'stale' "$remote" "$local_branch_names_var" "$remote_branch_names_var" "$local_branch_outcomes_var" "$remote_branch_outcomes_var"
  print_summary_status 'failed' "$remote" "$local_branch_names_var" "$remote_branch_names_var" "$local_branch_outcomes_var" "$remote_branch_outcomes_var"
  print_summary_status 'not-attempted' "$remote" "$local_branch_names_var" "$remote_branch_names_var" "$local_branch_outcomes_var" "$remote_branch_outcomes_var"
}

render_git_clean_branches_plan() {
  local remote="$1"
  local default_branch="$2"
  local current_branch="$3"
  local local_branch_names_var="$4"
  local remote_branch_names_var="$5"
  local -n _gcb_rendered_local_branch_names="$local_branch_names_var"
  local -n _gcb_rendered_remote_branch_names="$remote_branch_names_var"

  printf 'Remote: %s\n' "$remote"
  printf 'Default branch: %s\n' "$default_branch"
  printf 'Current branch: %s\n' "$current_branch"

  if [ "${#_gcb_rendered_local_branch_names[@]}" -eq 0 ] && [ "${#_gcb_rendered_remote_branch_names[@]}" -eq 0 ]; then
    echo "Nothing to delete."
    return 2
  fi

  if [ "${#_gcb_rendered_local_branch_names[@]}" -gt 0 ]; then
    echo "Local branches to delete:"
    printf '  %s\n' "${_gcb_rendered_local_branch_names[@]}"
  fi

  if [ "${#_gcb_rendered_remote_branch_names[@]}" -gt 0 ]; then
    echo "Remote branches to delete:"
    printf '  %s\n' "${_gcb_rendered_remote_branch_names[@]}"
  fi
}

collect_command_output() {
  local output_var="$1"
  shift

  local output
  if ! output=$("$@"); then
    return 1
  fi

  printf -v "$output_var" '%s' "$output"
}

collect_ref_oid_records() {
  local refs_var="$1"
  local oids_var="$2"
  shift 2

  local -n _gcb_collected_refs="$refs_var"
  local -n _gcb_collected_oids="$oids_var"
  local tmp ref oid record
  local records=()

  tmp=$(mktemp) || return 1
  if ! "$@" >"$tmp"; then
    rm -f "$tmp"
    return 1
  fi

  mapfile -t records <"$tmp"
  rm -f "$tmp"

  _gcb_collected_refs=()
  _gcb_collected_oids=()
  for record in "${records[@]}"; do
    IFS=' ' read -r ref oid <<<"$record"
    [ -z "$ref" ] && continue
    [ -z "$oid" ] && {
      return 1
    }
    _gcb_collected_refs+=("$ref")
    _gcb_collected_oids+=("$oid")
  done
}

discover_protected_refs() {
  local remote="$1"
  local current_branch_var="$2"
  local default_branch_var="$3"
  local worktree_branches_var="$4"
  local -n _gcb_discovered_current_branch="$current_branch_var"
  local -n _gcb_discovered_default_branch="$default_branch_var"
  local -n _gcb_discovered_worktree_branches="$worktree_branches_var"
  local worktree_output

  _gcb_discovered_current_branch=$(git branch --show-current)
  if [ -z "$_gcb_discovered_current_branch" ]; then
    echo "Error: detached HEAD is not supported" >&2
    return 1
  fi

  debug_log "Fetching '$remote' with prune"
  git fetch --prune -- "$remote" || return 1

  if ! _gcb_discovered_default_branch=$(resolve_remote_default_branch "$remote"); then
    echo "Error: could not determine the default branch for remote '$remote'" >&2
    return 1
  fi

  if ! validate_remote_default_branch "$remote" "$_gcb_discovered_default_branch"; then
    echo "Error: remote default branch '$remote/$_gcb_discovered_default_branch' is not available locally after fetch" >&2
    return 1
  fi

  if ! collect_command_output worktree_output git worktree list --porcelain; then
    echo 'Error: failed to discover worktree branches' >&2
    return 1
  fi
  parse_worktree_branches "$worktree_output" "$worktree_branches_var"
}

discover_candidate_refs() {
  local remote="$1"
  local default_branch="$2"
  local local_refs_var="$3"
  local local_oids_var="$4"
  local remote_refs_var="$5"
  local remote_oids_var="$6"

  if ! collect_ref_oid_records "$local_refs_var" "$local_oids_var" git for-each-ref --format='%(refname) %(objectname)' refs/heads; then
    echo 'Error: failed to discover local branches' >&2
    return 1
  fi

  if ! collect_ref_oid_records "$remote_refs_var" "$remote_oids_var" git for-each-ref --format='%(refname) %(objectname)' --merged "refs/remotes/${remote}/${default_branch}" "refs/remotes/${remote}"; then
    echo 'Error: failed to discover remote branches' >&2
    return 1
  fi
}

remote_ls_oid() {
  local ls_output="$1"
  local expected_ref="$2"
  local line oid ref

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    oid=${line%%$'\t'*}
    ref=${line#*$'\t'}
    if [ "$ref" = "$expected_ref" ]; then
      printf '%s\n' "$oid"
      return 0
    fi
  done <<<"$ls_output"

  return 1
}

remote_head_oid() {
  local remote="$1"
  local branch="$2"
  local remote_output

  collect_command_output remote_output git ls-remote --heads -- "$remote" "$branch" || return 1
  remote_ls_oid "$remote_output" "refs/heads/$branch"
}

git_push_supports_atomic_deletion() {
  local remote="$1"
  local remote_destination_refs_var="$2"
  local remote_branch_oids_var="$3"
  local -n _gcb_atomic_remote_destination_refs="$remote_destination_refs_var"
  local -n _gcb_atomic_remote_branch_oids="$remote_branch_oids_var"
  local output
  local push_args=(push --porcelain --dry-run --atomic)
  local i

  for i in "${!_gcb_atomic_remote_destination_refs[@]}"; do
    push_args+=(--force-with-lease="${_gcb_atomic_remote_destination_refs[$i]}:${_gcb_atomic_remote_branch_oids[$i]}")
  done
  push_args+=(-- "$remote")
  for i in "${!_gcb_atomic_remote_destination_refs[@]}"; do
    push_args+=(":${_gcb_atomic_remote_destination_refs[$i]}")
  done

  if ! output=$(git "${push_args[@]}" 2>&1); then
    printf '%s\n' "$output" >&2
    return 1
  fi
}

preflight_remote_deletion_requirements() {
  local remote="$1"
  local remote_destination_refs_var="$2"
  local remote_branch_oids_var="$3"
  local remote_branch_names_var="$4"
  local remote_branch_outcomes_var="$5"
  local -n _gcb_preflight_remote_destination_refs="$remote_destination_refs_var"
  local -n _gcb_preflight_remote_branch_oids="$remote_branch_oids_var"
  local -n _gcb_preflight_remote_branch_names="$remote_branch_names_var"
  local -n _gcb_preflight_remote_branch_outcomes="$remote_branch_outcomes_var"
  local ls_output oid i

  [ "${#_gcb_preflight_remote_destination_refs[@]}" -eq 0 ] && return 0

  if ! collect_command_output ls_output git ls-remote --heads -- "$remote"; then
    echo "Error: failed to preflight remote branch state for '$remote'" >&2
    for i in "${!_gcb_preflight_remote_branch_names[@]}"; do
      _gcb_preflight_remote_branch_outcomes[i]='failed'
    done
    return 1
  fi

  for i in "${!_gcb_preflight_remote_destination_refs[@]}"; do
    if ! oid=$(remote_ls_oid "$ls_output" "${_gcb_preflight_remote_destination_refs[$i]}"); then
      _gcb_preflight_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote branch '$remote/${_gcb_preflight_remote_branch_names[$i]}' no longer exists"
      return 1
    fi

    if [ "$oid" != "${_gcb_preflight_remote_branch_oids[$i]}" ]; then
      _gcb_preflight_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote branch '$remote/${_gcb_preflight_remote_branch_names[$i]}' moved since the plan was reviewed"
      return 1
    fi
  done

  if ! git_push_supports_atomic_deletion "$remote" "$remote_destination_refs_var" "$remote_branch_oids_var"; then
    echo "Error: remote '$remote' does not support required atomic deletion; no branches were deleted" >&2
    for i in "${!_gcb_preflight_remote_branch_names[@]}"; do
      _gcb_preflight_remote_branch_outcomes[i]='failed'
    done
    return 1
  fi
}

collect_git_clean_branches_plan() {
  local remote="$1"
  local current_branch="$2"
  local default_branch="$3"
  local discovered_local_refs_var="$4"
  local discovered_local_oids_var="$5"
  local discovered_remote_refs_var="$6"
  local discovered_remote_oids_var="$7"
  local worktree_branches_var="$8"
  local local_branch_refs_var="$9"
  local local_branch_oids_var="${10}"
  local local_branch_names_var="${11}"
  local remote_tracking_refs_var="${12}"
  local remote_destination_refs_var="${13}"
  local remote_branch_oids_var="${14}"
  local remote_branch_names_var="${15}"

  local -n _gcb_plan_discovered_local_refs="$discovered_local_refs_var"
  local -n _gcb_plan_discovered_local_oids="$discovered_local_oids_var"
  local -n _gcb_plan_discovered_remote_refs="$discovered_remote_refs_var"
  local -n _gcb_plan_discovered_remote_oids="$discovered_remote_oids_var"
  local -n _gcb_plan_worktree_branches="$worktree_branches_var"
  local -n _gcb_plan_local_branch_refs="$local_branch_refs_var"
  local -n _gcb_plan_local_branch_oids="$local_branch_oids_var"
  local -n _gcb_plan_local_branch_names="$local_branch_names_var"
  local -n _gcb_plan_remote_tracking_refs="$remote_tracking_refs_var"
  local -n _gcb_plan_remote_destination_refs="$remote_destination_refs_var"
  local -n _gcb_plan_remote_branch_oids="$remote_branch_oids_var"
  local -n _gcb_plan_remote_branch_names="$remote_branch_names_var"
  local branch ref oid dst_ref
  local local_branch_prefix='refs/heads/'
  local remote_tracking_prefix="refs/remotes/${remote}/"
  local i
  local -A worktree_branch_set=()

  _gcb_plan_local_branch_refs=()
  _gcb_plan_local_branch_oids=()
  _gcb_plan_local_branch_names=()
  _gcb_plan_remote_tracking_refs=()
  _gcb_plan_remote_destination_refs=()
  _gcb_plan_remote_branch_oids=()
  _gcb_plan_remote_branch_names=()

  for branch in "${_gcb_plan_worktree_branches[@]}"; do
    worktree_branch_set["$branch"]=1
  done

  for i in "${!_gcb_plan_discovered_local_refs[@]}"; do
    ref="${_gcb_plan_discovered_local_refs[$i]}"
    oid="${_gcb_plan_discovered_local_oids[$i]:-}"
    [ -z "$ref" ] && continue
    [ -z "$oid" ] && return 1
    case "$ref" in
    refs/heads/*) ;;
    *) return 1 ;;
    esac

    branch="${ref#"$local_branch_prefix"}"
    [ "$branch" = "$default_branch" ] && continue
    [ "$branch" = "$current_branch" ] && continue
    [ -n "${worktree_branch_set[$branch]+present}" ] && continue

    _gcb_plan_local_branch_refs+=("$ref")
    _gcb_plan_local_branch_oids+=("$oid")
    _gcb_plan_local_branch_names+=("$branch")
  done

  for i in "${!_gcb_plan_discovered_remote_refs[@]}"; do
    ref="${_gcb_plan_discovered_remote_refs[$i]}"
    oid="${_gcb_plan_discovered_remote_oids[$i]:-}"
    [ -z "$ref" ] && continue
    [ -z "$oid" ] && return 1
    [ "$ref" = "refs/remotes/${remote}/HEAD" ] && continue

    case "$ref" in
    refs/remotes/"$remote"/*) ;;
    *) return 1 ;;
    esac

    branch="${ref#"$remote_tracking_prefix"}"
    [ "$branch" = "$default_branch" ] && continue
    [ "$branch" = "$current_branch" ] && continue

    dst_ref="refs/heads/${branch}"
    _gcb_plan_remote_tracking_refs+=("$ref")
    _gcb_plan_remote_destination_refs+=("$dst_ref")
    _gcb_plan_remote_branch_oids+=("$oid")
    _gcb_plan_remote_branch_names+=("$branch")
  done
}

revalidate_git_clean_branches_plan() {
  local remote="$1"
  local reviewed_current_branch="$2"
  local reviewed_default_branch="$3"
  local reviewed_default_branch_oid="$4"
  local local_branch_refs_var="$5"
  local local_branch_oids_var="$6"
  local local_branch_names_var="$7"
  local remote_tracking_refs_var="$8"
  local remote_branch_oids_var="$9"
  local remote_branch_names_var="${10}"
  local local_branch_outcomes_var="${11}"
  local remote_branch_outcomes_var="${12}"
  local -n _gcb_revalidate_local_branch_refs="$local_branch_refs_var"
  local -n _gcb_revalidate_local_branch_oids="$local_branch_oids_var"
  local -n _gcb_revalidate_local_branch_names="$local_branch_names_var"
  local -n _gcb_revalidate_remote_tracking_refs="$remote_tracking_refs_var"
  local -n _gcb_revalidate_remote_branch_oids="$remote_branch_oids_var"
  local -n _gcb_revalidate_remote_branch_names="$remote_branch_names_var"
  local -n _gcb_revalidate_local_branch_outcomes="$local_branch_outcomes_var"
  local -n _gcb_revalidate_remote_branch_outcomes="$remote_branch_outcomes_var"
  local application_default_branch current_branch worktree_output branch ref oid default_ref remote_default_oid
  local revalidated_worktree_branches=()
  local i

  current_branch=$(git branch --show-current)
  if [ -z "$current_branch" ]; then
    fail_stale_plan 'current branch became detached'
    return 1
  fi

  if [ "$current_branch" != "$reviewed_current_branch" ]; then
    fail_stale_plan "current branch changed from '$reviewed_current_branch' to '$current_branch'"
    return 1
  fi

  if ! application_default_branch=$(resolve_remote_default_branch "$remote"); then
    echo "Error: default branch for remote '$remote' became unavailable before deletion" >&2
    return 1
  fi

  if [ "$application_default_branch" != "$reviewed_default_branch" ]; then
    echo "Error: default branch changed from '$reviewed_default_branch' to '$application_default_branch'; refusing stale deletion plan" >&2
    return 1
  fi

  if ! validate_remote_default_branch "$remote" "$application_default_branch"; then
    echo "Error: remote default branch '$remote/$application_default_branch' is not available before deletion" >&2
    return 1
  fi

  if ! remote_default_oid=$(remote_head_oid "$remote" "$application_default_branch"); then
    echo "Error: failed to preflight remote default branch '$remote/$application_default_branch'" >&2
    return 1
  fi

  if [ "$remote_default_oid" != "$reviewed_default_branch_oid" ]; then
    fail_stale_plan "remote default branch '$remote/$application_default_branch' moved since the plan was reviewed"
    return 1
  fi

  if ! collect_command_output worktree_output git worktree list --porcelain; then
    echo 'Error: failed to rediscover worktree branches before deletion' >&2
    return 1
  fi
  parse_worktree_branches "$worktree_output" revalidated_worktree_branches

  for i in "${!_gcb_revalidate_local_branch_refs[@]}"; do
    ref="${_gcb_revalidate_local_branch_refs[$i]}"
    branch="${_gcb_revalidate_local_branch_names[$i]}"

    if [ "$branch" = "$application_default_branch" ] || [ "$branch" = "$current_branch" ]; then
      _gcb_revalidate_local_branch_outcomes[i]='stale'
      fail_stale_plan "local branch '$branch' is now protected"
      return 1
    fi

    if contains_branch "$branch" "${revalidated_worktree_branches[@]}"; then
      _gcb_revalidate_local_branch_outcomes[i]='stale'
      fail_stale_plan "local branch '$branch' is checked out in another worktree"
      return 1
    fi

    if ! oid=$(ref_oid "$ref"); then
      _gcb_revalidate_local_branch_outcomes[i]='stale'
      fail_stale_plan "local branch '$branch' no longer exists"
      return 1
    fi

    if [ "$oid" != "${_gcb_revalidate_local_branch_oids[$i]}" ]; then
      _gcb_revalidate_local_branch_outcomes[i]='stale'
      fail_stale_plan "local branch '$branch' moved since the plan was reviewed"
      return 1
    fi
  done

  default_ref="refs/remotes/${remote}/${application_default_branch}"
  for i in "${!_gcb_revalidate_remote_tracking_refs[@]}"; do
    ref="${_gcb_revalidate_remote_tracking_refs[$i]}"
    branch="${_gcb_revalidate_remote_branch_names[$i]}"

    if [ "$branch" = "$application_default_branch" ] || [ "$branch" = "$current_branch" ]; then
      _gcb_revalidate_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote branch '$remote/$branch' is now protected"
      return 1
    fi

    if ! oid=$(ref_oid "$ref"); then
      _gcb_revalidate_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote tracking branch '$remote/$branch' no longer exists"
      return 1
    fi

    if [ "$oid" != "${_gcb_revalidate_remote_branch_oids[$i]}" ]; then
      _gcb_revalidate_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote tracking branch '$remote/$branch' moved since the plan was reviewed"
      return 1
    fi

    if ! git merge-base --is-ancestor -- "$oid" "$default_ref"; then
      _gcb_revalidate_remote_branch_outcomes[i]='stale'
      fail_stale_plan "remote branch '$remote/$branch' is no longer merged into '$remote/$application_default_branch'"
      return 1
    fi
  done
}

delete_local_branches() {
  local local_branch_refs_var="$1"
  local local_branch_oids_var="$2"
  local local_branch_names_var="$3"
  local local_branch_outcomes_var="$4"
  local -n _gcb_delete_local_branch_refs="$local_branch_refs_var"
  local -n _gcb_delete_local_branch_oids="$local_branch_oids_var"
  local -n _gcb_delete_local_branch_names="$local_branch_names_var"
  local -n _gcb_delete_local_branch_outcomes="$local_branch_outcomes_var"
  local i

  [ "${#_gcb_delete_local_branch_refs[@]}" -eq 0 ] && return 0

  if should_inject_failure 'before-local-transaction'; then
    echo 'Error: injected failure before local branch transaction' >&2
    for i in "${!_gcb_delete_local_branch_names[@]}"; do
      _gcb_delete_local_branch_outcomes[i]='failed'
    done
    return 1
  fi

  # update-ref gives expected-OID CAS but bypasses linked-worktree occupancy;
  # the immediately preceding worktree preflight is the final available guard.
  if ! {
    printf 'start\n'
    for i in "${!_gcb_delete_local_branch_refs[@]}"; do
      debug_log "Deleting local ref '${_gcb_delete_local_branch_refs[$i]}' at '${_gcb_delete_local_branch_oids[$i]}'"
      printf 'delete %s %s\n' "${_gcb_delete_local_branch_refs[$i]}" "${_gcb_delete_local_branch_oids[$i]}"
    done
    printf 'prepare\n'
    printf 'commit\n'
  } | git update-ref --stdin; then
    fail_stale_plan 'local branch refs changed during compare-and-swap deletion'
    for i in "${!_gcb_delete_local_branch_names[@]}"; do
      _gcb_delete_local_branch_outcomes[i]='failed'
    done
    return 1
  fi

  for i in "${!_gcb_delete_local_branch_names[@]}"; do
    _gcb_delete_local_branch_outcomes[i]='succeeded'
  done
}

delete_remote_branches() {
  local remote="$1"
  local remote_destination_refs_var="$2"
  local remote_branch_oids_var="$3"
  local remote_branch_names_var="$4"
  local remote_branch_outcomes_var="$5"
  local -n _gcb_delete_remote_destination_refs="$remote_destination_refs_var"
  local -n _gcb_delete_remote_branch_oids="$remote_branch_oids_var"
  local -n _gcb_delete_remote_branch_names="$remote_branch_names_var"
  local -n _gcb_delete_remote_branch_outcomes="$remote_branch_outcomes_var"
  local output
  local i
  local push_args=(push --porcelain --atomic)

  [ "${#_gcb_delete_remote_destination_refs[@]}" -eq 0 ] && return 0

  if should_inject_failure 'remote-push'; then
    echo 'Error: injected failure during remote branch push' >&2
    for i in "${!_gcb_delete_remote_branch_names[@]}"; do
      _gcb_delete_remote_branch_outcomes[i]='failed'
    done
    return 1
  fi

  for i in "${!_gcb_delete_remote_destination_refs[@]}"; do
    debug_log "Deleting remote ref '${_gcb_delete_remote_destination_refs[$i]}' at '${_gcb_delete_remote_branch_oids[$i]}'"
    push_args+=(--force-with-lease="${_gcb_delete_remote_destination_refs[$i]}:${_gcb_delete_remote_branch_oids[$i]}")
  done
  push_args+=(-- "$remote")
  for i in "${!_gcb_delete_remote_destination_refs[@]}"; do
    push_args+=(":${_gcb_delete_remote_destination_refs[$i]}")
  done

  if ! output=$(git "${push_args[@]}" 2>&1); then
    printf '%s\n' "$output" >&2
    echo "Error: atomic remote deletion failed for '$remote'; local deletions remain completed" >&2
    for i in "${!_gcb_delete_remote_branch_names[@]}"; do
      _gcb_delete_remote_branch_outcomes[i]='failed'
    done
    return 1
  fi

  for i in "${!_gcb_delete_remote_branch_names[@]}"; do
    _gcb_delete_remote_branch_outcomes[i]='succeeded'
  done
}

preflight_git_clean_branches_plan() {
  local remote="$1"
  local current_branch="$2"
  local default_branch="$3"
  local default_branch_oid="$4"
  local local_branch_refs_var="$5"
  local local_branch_oids_var="$6"
  local local_branch_names_var="$7"
  local remote_tracking_refs_var="$8"
  local remote_destination_refs_var="$9"
  local remote_branch_oids_var="${10}"
  local remote_branch_names_var="${11}"
  local local_branch_outcomes_var="${12}"
  local remote_branch_outcomes_var="${13}"

  revalidate_git_clean_branches_plan "$remote" "$current_branch" "$default_branch" "$default_branch_oid" "$local_branch_refs_var" "$local_branch_oids_var" "$local_branch_names_var" "$remote_tracking_refs_var" "$remote_branch_oids_var" "$remote_branch_names_var" "$local_branch_outcomes_var" "$remote_branch_outcomes_var" || return 1
  preflight_remote_deletion_requirements "$remote" "$remote_destination_refs_var" "$remote_branch_oids_var" "$remote_branch_names_var" "$remote_branch_outcomes_var"
}

apply_git_clean_branches_plan() {
  local remote="$1"
  local local_branch_refs_var="$2"
  local local_branch_oids_var="$3"
  local local_branch_names_var="$4"
  local remote_destination_refs_var="$5"
  local remote_branch_oids_var="$6"
  local remote_branch_names_var="$7"
  local local_branch_outcomes_var="$8"
  local remote_branch_outcomes_var="$9"

  delete_local_branches "$local_branch_refs_var" "$local_branch_oids_var" "$local_branch_names_var" "$local_branch_outcomes_var" || return 1

  if should_inject_failure 'between-local-and-remote'; then
    echo 'Error: injected failure between local and remote deletion phases' >&2
    return 1
  fi

  delete_remote_branches "$remote" "$remote_destination_refs_var" "$remote_branch_oids_var" "$remote_branch_names_var" "$remote_branch_outcomes_var"
}

main() {
  local assume_yes=false
  local remote=origin
  local action=run
  local current_branch default_branch default_branch_oid
  local worktree_branches=()
  local discovered_local_refs=()
  local discovered_local_oids=()
  local discovered_remote_refs=()
  local discovered_remote_oids=()
  local local_branch_refs=()
  local local_branch_oids=()
  local local_branch_names=()
  local remote_tracking_refs=()
  local remote_destination_refs=()
  local remote_branch_oids=()
  local remote_branch_names=()
  local local_branch_outcomes=()
  local remote_branch_outcomes=()
  local render_status=0

  parse_git_clean_branches_args remote assume_yes action "$@" || return 1
  case "$action" in
  help)
    usage
    return 0
    ;;
  version)
    print_version
    return 0
    ;;
  esac

  picotools_require_git_repo

  if ! git remote get-url -- "$remote" >/dev/null 2>&1; then
    echo "Error: remote '$remote' does not exist" >&2
    return 1
  fi

  debug_log "Cleaning branches against remote '$remote'"

  discover_protected_refs "$remote" current_branch default_branch worktree_branches || return 1
  if ! default_branch_oid=$(ref_oid "refs/remotes/${remote}/${default_branch}"); then
    echo "Error: failed to record reviewed remote default branch OID" >&2
    return 1
  fi
  discover_candidate_refs "$remote" "$default_branch" discovered_local_refs discovered_local_oids discovered_remote_refs discovered_remote_oids || return 1

  if ! collect_git_clean_branches_plan "$remote" "$current_branch" "$default_branch" discovered_local_refs discovered_local_oids discovered_remote_refs discovered_remote_oids worktree_branches local_branch_refs local_branch_oids local_branch_names remote_tracking_refs remote_destination_refs remote_branch_oids remote_branch_names; then
    echo 'Error: failed to build a validated branch deletion plan' >&2
    return 1
  fi
  init_operation_outcomes local_branch_names remote_branch_names local_branch_outcomes remote_branch_outcomes

  debug_log "Collected ${#local_branch_names[@]} local and ${#remote_branch_names[@]} remote branch(es) to delete"
  render_git_clean_branches_plan "$remote" "$default_branch" "$current_branch" local_branch_names remote_branch_names || render_status=$?
  [ "$render_status" -eq 2 ] && return 0
  [ "$render_status" -eq 0 ] || return "$render_status"

  if [ "$assume_yes" != true ]; then
    picotools_confirm_action "Proceed with deleting these branches?" || return 1
  fi

  if ! preflight_git_clean_branches_plan "$remote" "$current_branch" "$default_branch" "$default_branch_oid" local_branch_refs local_branch_oids local_branch_names remote_tracking_refs remote_destination_refs remote_branch_oids remote_branch_names local_branch_outcomes remote_branch_outcomes; then
    print_cleanup_summary "$remote" local_branch_names remote_branch_names local_branch_outcomes remote_branch_outcomes
    return 1
  fi

  if ! apply_git_clean_branches_plan "$remote" local_branch_refs local_branch_oids local_branch_names remote_destination_refs remote_branch_oids remote_branch_names local_branch_outcomes remote_branch_outcomes; then
    print_cleanup_summary "$remote" local_branch_names remote_branch_names local_branch_outcomes remote_branch_outcomes
    return 1
  fi

  print_cleanup_summary "$remote" local_branch_names remote_branch_names local_branch_outcomes remote_branch_outcomes
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
